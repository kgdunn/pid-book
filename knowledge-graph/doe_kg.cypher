// DOE knowledge graph, built from pid-book PR #22. Load into an empty database.
CREATE CONSTRAINT doe_node_id IF NOT EXISTS FOR (n:DOE) REQUIRE n.id IS UNIQUE;
CREATE (:DOE:Concept {id: "experiment", name: "Experiment", definition: "Intentionally disturbing a system by changing factors, to learn cause and effect.", aliases: [], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "run", name: "Run", definition: "One experiment in a set: eight experiments are eight runs.", aliases: ["experimental run"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "response", name: "Response", definition: "The measured outcome of a run, written y. It must always be measurable in some way.", aliases: ["outcome", "response variable", "y"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "qualitative_outcome", name: "Qualitative outcome", definition: "An outcome described in categories, such as pass or fail, or a colour.", aliases: [], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "objective", name: "Objective", definition: "An outcome together with what you want of it: maximize, minimize, or keep the same.", aliases: ["goal"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "factor", name: "Factor", definition: "The thing you can change to influence the outcome.", aliases: ["variable", "input"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "numeric_factor", name: "Numeric factor", definition: "A factor with ordered, measured values, such as 15 mL or 30 mL of water.", aliases: ["quantitative factor", "continuous factor"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "categorical_factor", name: "Categorical factor", definition: "A factor with a few values that have no order, such as soil A or soil B.", aliases: ["qualitative factor"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst"});
CREATE (:DOE:Concept {id: "level", name: "Level", definition: "A setting of a factor in a design, such as its low (-1) or high (+1) value.", aliases: ["low level", "high level"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "cause_and_effect", name: "Cause and effect", definition: "A change in a factor that produces a change in the response; shown only by intentional manipulation.", aliases: ["causality"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "happenstance_data", name: "Happenstance data", definition: "Everyday operating data, collected without intentional changes; it cannot show cause and effect.", aliases: ["operating data"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "feedback_control", name: "Feedback control", definition: "Control systems keep operation in a small zone, so the data they produce carry little information.", aliases: [], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "correlation", name: "Correlation", definition: "Two variables moving together: necessary, but not sufficient, for causality.", aliases: [], book_label: "DOE-yield-pressure-impurity-correlation", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "learning_cycle", name: "Learning cycle", definition: "Conjecture, expected consequences, experiment and data, then a new or revised conjecture.", aliases: ["iterative learning"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "conjecture", name: "Conjecture", definition: "A hypothesis believed true, whose consequences an experiment tests.", aliases: ["hypothesis"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "troubleshooting", name: "Troubleshooting", definition: "Experimenting to fix a problem, which also teaches you about the system.", aliases: [], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Concept {id: "disturbance", name: "Disturbance", definition: "A variable that affects y but is not of interest: operators, ambient conditions, equipment, lab analyses, time.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Concept {id: "controlled_disturbance", name: "Controlled disturbance", definition: "A disturbance held constant for all runs, so its effect cancels out.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Concept {id: "time_effect", name: "Time-dependent effect", definition: "Slow changes such as catalyst deactivation or fouling that affect the response over time.", aliases: ["drift"], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Concept {id: "randomization", name: "Randomization", definition: "Running experiments in random order so unknown disturbances cannot systematically affect the response.", aliases: ["random order"], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "independence", name: "Independence", definition: "The assumption behind t-based confidence intervals; randomization guarantees it.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Method {id: "randomization_test", name: "Randomization test", definition: "Compare the observed difference with the differences from every possible reassignment of the A and B labels.", aliases: ["permutation test"], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Method {id: "pairing", name: "Pairing", definition: "Running two experiments on the same subject and analysing their difference, so a shared disturbance cancels.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Method {id: "two_group_comparison", name: "Comparing two conditions", definition: "Comparing condition A with B using a pooled variance and a confidence interval for the difference.", aliases: ["A versus B test"], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "pooled_variance", name: "Pooled variance", definition: "A combined variance estimate from two groups, used in the z-value for their difference.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "indicator_variable", name: "Indicator variable", definition: "A 0/1 variable that codes condition A or B in a least squares model.", aliases: ["dummy variable"], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "confidence_interval", name: "Confidence interval", definition: "A range for an effect; the effect is statistically significant when the interval does not span zero.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "t_distribution", name: "t-distribution", definition: "The reference distribution for a difference or a coefficient divided by its standard error.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "null_hypothesis", name: "Null hypothesis", definition: "The assumption that there is no difference between A and B.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "statistical_significance", name: "Statistical significance", definition: "An effect larger than the noise, judged by its confidence interval.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Concept {id: "practical_significance", name: "Practical significance", definition: "Whether an effect is large enough to matter, judged from the interval's width and the process variance.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Method {id: "cost", name: "Changing one single variable at a time", definition: "Changing one factor at a time: an inefficient way to experiment that can stop at a suboptimal point.", aliases: ["COST", "OFAT", "one factor at a time"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst"});
CREATE (:DOE:Concept {id: "false_optimum", name: "False optimum", definition: "A point that looks best when factors are changed one at a time, but is not the optimum.", aliases: ["suboptimal solution"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst"});
CREATE (:DOE:Concept {id: "order_dependence", name: "Order dependence", definition: "With COST the result depends on which factor is changed first.", aliases: [], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst"});
CREATE (:DOE:Concept {id: "designed_experiment", name: "Designed experiment", definition: "A planned set of runs that changes several factors together, in random order, so the result does not depend on run order.", aliases: ["DOE", "design of experiments", "experimental design"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst"});
CREATE (:DOE:DesignType {id: "full_factorial", name: "Full factorial", definition: "Every combination of the factors' two levels: 2^k runs for k factors.", aliases: ["2^k factorial", "two-level factorial"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "coding", name: "Coding", definition: "Centering and scaling a factor: (value - center)/(range/2), so low is -1 and high is +1.", aliases: ["coded units", "centering and scaling"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Concept {id: "standard_order", name: "Standard order", definition: "Writing runs with the first factor's sign alternating fastest and the last slowest.", aliases: ["Yates order"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Guideline {id: "operating_range", name: "Choosing the factor range", definition: "Choose low and high at the edges of normal operation, not at the extreme values a factor could take.", aliases: [], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Plot {id: "cube_plot", name: "Cube plot", definition: "The design drawn as a square or cube with the response written at each corner.", aliases: [], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "main_effect", name: "Main effect", definition: "The average change in y when a factor moves from its low to its high level.", aliases: ["effect"], book_label: "DOE-two-level-factorials-main-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "interaction", name: "Interaction", definition: "When the effect of one factor depends on the level of another. Interactions are symmetric.", aliases: ["interaction effect"], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "two_factor_interaction", name: "Two-factor interaction", definition: "The interaction of two factors, such as T x S.", aliases: ["2fi"], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "three_factor_interaction", name: "Three-factor interaction", definition: "The interaction of three factors; seldom large in real systems.", aliases: ["3fi"], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst"});
CREATE (:DOE:Plot {id: "interaction_plot", name: "Interaction plot", definition: "The response against one factor, a line per level of another; lines that are not parallel show interaction.", aliases: [], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Concept {id: "half_range_effect", name: "Effect over half the range", definition: "This book reports an effect as the change over half the factor's range; Box, Hunter and Hunter report double.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst"});
CREATE (:DOE:Method {id: "least_squares_model", name: "Least squares model", definition: "y = Xb + e, fitted with b = (X'X)^-1 X'y. It works even when the design was not run exactly as planned.", aliases: ["linear model", "regression"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Concept {id: "model_matrix", name: "Model matrix X", definition: "One row per run and one column per model term, with a column of ones for the intercept.", aliases: ["X matrix", "design matrix"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Property {id: "orthogonality", name: "Orthogonality", definition: "The columns of X are independent, so X'X is diagonal and each coefficient is estimated and read on its own.", aliases: ["orthogonal design"], book_label: "DOE_orthogonality", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Concept {id: "intercept", name: "Intercept", definition: "The model's constant b0; for a coded factorial, the average of the runs and the predicted center point.", aliases: ["b0"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Concept {id: "coefficient", name: "Coefficient", definition: "The change in y for a one-unit change in a coded factor, that is, over half its range.", aliases: ["parameter", "slope"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst"});
CREATE (:DOE:Guideline {id: "hierarchy_rule", name: "Keep the parent main effects", definition: "If an interaction is significant, keep in the model every main effect that it is made of.", aliases: ["model hierarchy"], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst"});
CREATE (:DOE:Guideline {id: "interpret_with_interaction", name: "Read main effects with their interactions", definition: "A main effect cannot be interpreted on its own when it takes part in a significant interaction.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst"});
CREATE (:DOE:Concept {id: "robustness", name: "Robustness", definition: "A small effect means y is insensitive to that factor: y is robust to changes in it.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst"});
CREATE (:DOE:Concept {id: "degrees_of_freedom", name: "Degrees of freedom", definition: "Runs minus estimated parameters; needed to estimate the standard error.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Concept {id: "replicate", name: "Replicate", definition: "A complete repeat of a run: setup, running the experiment and measuring the result.", aliases: ["replication"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Concept {id: "repeat_measurement", name: "Repeat measurement", definition: "Measuring one sample twice; it estimates only measurement error and is not a true replicate.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Concept {id: "center_point", name: "Center point", definition: "A run with every factor at coded 0. It tests curvature and adds degrees of freedom without breaking orthogonality.", aliases: ["centre point", "baseline run"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Concept {id: "standard_error", name: "Standard error", definition: "The noise estimate from the residuals; for a coefficient, SE(b) = sqrt(S_E^2 / sum x^2).", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Plot {id: "pareto_plot", name: "Pareto plot", definition: "Absolute coefficients in sorted order, intercept left out; significance judged by eye. Needs coded factors.", aliases: [], book_label: "DOE-Pareto-plot", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Method {id: "se_significance", name: "Significance from standard errors", definition: "Report each effect with its standard error; it is significant when effect +/- c_t x SE excludes zero.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Method {id: "refit", name: "Refit without small effects", definition: "Drop clearly small effects to gain degrees of freedom, then estimate the error and check the residuals.", aliases: ["model reduction"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Method {id: "residual_analysis", name: "Residual analysis", definition: "Residuals plotted in run order, against fitted values, and on a q-q plot.", aliases: ["residual plots"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Property {id: "factorial_efficiency", name: "Factorial efficiency", definition: "A factorial estimates a main effect with half the variance of COST: each observation works twice.", aliases: [], book_label: "DOE-COST-vs-factorial-efficiency", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst"});
CREATE (:DOE:Concept {id: "missing_values", name: "Missing values", definition: "Lost responses. Drop high-order terms so the model can still be fitted by least squares.", aliases: [], book_label: null, book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst"});
CREATE (:DOE:Concept {id: "off_target_run", name: "Off-target run", definition: "A run set to a level other than planned. Code its actual value and fit by least squares; X is then almost orthogonal.", aliases: [], book_label: null, book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst"});
CREATE (:DOE:DesignType {id: "fractional_factorial", name: "Fractional factorial", definition: "A fraction of a full factorial: 2^(k-p) runs for k factors.", aliases: ["2^(k-p) design"], book_label: "DOE-fractional-factorials", book_file: "design-analysis-experiments/fractional-factorial-designs/index.rst"});
CREATE (:DOE:DesignType {id: "half_fraction", name: "Half fraction", definition: "Half of a full factorial: 2^(k-1) runs.", aliases: [], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst"});
CREATE (:DOE:DesignType {id: "quarter_fraction", name: "Quarter fraction", definition: "A quarter of a full factorial: 2^(k-2) runs.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst"});
CREATE (:DOE:DesignType {id: "complementary_fraction", name: "Complementary half fraction", definition: "The other half of a full factorial, made by flipping the sign of the generator.", aliases: [], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:DesignType {id: "saturated_design", name: "Saturated design", definition: "A design with one run per estimated term, such as 7 factors in 8 runs; usually resolution III.", aliases: [], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst"});
CREATE (:DOE:DesignType {id: "plackett_burman", name: "Plackett-Burman design", definition: "A screening design in any multiple of 4 runs from 12: 12, 16, 20, 24, ...", aliases: ["PB design"], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst"});
CREATE (:DOE:Concept {id: "confounding", name: "Confounding", definition: "Two effects cannot be separated, so their coefficient estimates their sum.", aliases: ["confusing"], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst"});
CREATE (:DOE:Concept {id: "alias", name: "Alias", definition: "An effect confounded with another: A is an alias of BC.", aliases: ["aliasing"], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst"});
CREATE (:DOE:Concept {id: "alias_structure", name: "Alias structure", definition: "The list of aliases of every effect in a design.", aliases: ["confounding pattern"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Concept {id: "collinearity", name: "Collinearity", definition: "Identical columns in X, so X'X cannot be inverted.", aliases: [], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst"});
CREATE (:DOE:Concept {id: "generator", name: "Generator", definition: "Assigning an extra factor to an interaction column, such as D = ABC.", aliases: ["generating relation"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Concept {id: "word", name: "Word", definition: "A product of factor letters equal to I, such as ABD.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst"});
CREATE (:DOE:Concept {id: "defining_relation", name: "Defining relation", definition: "All the words equal to I, found from the products of the generators: 2^p words.", aliases: ["defining relationship"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Concept {id: "identity_column", name: "Identity column I", definition: "The column of ones. Any factor times itself is I.", aliases: [], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Method {id: "alias_calculation", name: "Finding aliases", definition: "Multiply an effect by the defining relation to list what it is aliased with.", aliases: [], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Guideline {id: "reassign_letters", name: "Reassign factors to letters", definition: "Choose which real factor gets which letter to obtain the least harmful confounding.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst"});
CREATE (:DOE:Property {id: "resolution", name: "Resolution", definition: "The length of the shortest word in the defining relation, written as a Roman numeral.", aliases: ["design resolution"], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Property {id: "resolution_iii", name: "Resolution III", definition: "Main effects are aliased with two-factor interactions. Good for screening.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Property {id: "resolution_iv", name: "Resolution IV", definition: "Main effects are clear of two-factor interactions, which are aliased with each other. Good for characterizing.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Property {id: "resolution_v", name: "Resolution V", definition: "Two-factor interactions are clear of each other. Good for optimizing.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Concept {id: "trade_off_table", name: "Trade-off table", definition: "Resolution against number of factors and runs (Box, Hunter and Hunter, p 272).", aliases: [], book_label: "DOE_design_trade_off_BHH_272", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Property {id: "projectivity", name: "Projectivity", definition: "A design of resolution R contains a full factorial in any R - 1 factors.", aliases: [], book_label: null, book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst"});
CREATE (:DOE:Method {id: "foldover", name: "Foldover", definition: "Running a second fraction with signs switched, then analysing both fractions together.", aliases: [], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst"});
CREATE (:DOE:Method {id: "single_factor_foldover", name: "Single-factor foldover", definition: "Switch the signs of one factor to de-alias it and its two-factor interactions.", aliases: ["switch one sign"], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst"});
CREATE (:DOE:Method {id: "full_foldover", name: "Full foldover", definition: "Switch all signs to raise a resolution III design to resolution IV.", aliases: ["switch all signs"], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst"});
CREATE (:DOE:Concept {id: "sequential_experimentation", name: "Sequential experimentation", definition: "Experiments are run in stages, each designed from what the last one revealed.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Concept {id: "screening", name: "Screening", definition: "Finding the few important factors among many candidates.", aliases: [], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst"});
CREATE (:DOE:Concept {id: "effect_sparsity", name: "Few large effects", definition: "Main effects matter most, then two-factor interactions; three-factor interactions are seldom large.", aliases: ["effect hierarchy", "sparsity of effects"], book_label: "DOE-fractional-factorials", book_file: "design-analysis-experiments/fractional-factorial-designs/index.rst"});
CREATE (:DOE:Method {id: "blocking", name: "Blocking", definition: "Running the experiment in groups so a known disturbance affects the response without misleading the results.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Concept {id: "block", name: "Block", definition: "A group of runs made under one level of a disturbance, such as one batch of material. Runs within a block are randomized.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Concept {id: "block_generator", name: "Block generator", definition: "The interaction the block effect is confounded with, such as block = ABC.", aliases: [], book_label: "DOE-Generators-for-blocking", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Guideline {id: "block_on_highest", name: "Block on the highest interaction", definition: "Confound the block effect with the highest-order interaction, which is expected to be small.", aliases: [], book_label: "DOE-Generators-for-blocking", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst"});
CREATE (:DOE:Method {id: "rsm", name: "Response surface methods", definition: "A sequential way to move a process towards its optimum by fitting and climbing local models.", aliases: ["RSM", "response surface methodology"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "response_surface", name: "Response surface", definition: "The unknown surface of y over the factors' space.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "steepest_ascent", name: "Steepest ascent", definition: "Move all factors together in proportion to their coefficients: delta x_i = (b_i / b_A) delta x_A.", aliases: ["path of steepest ascent"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "steepest_descent", name: "Steepest descent", definition: "Steepest ascent in the opposite direction, to minimize y.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "step_size", name: "Step size", definition: "Big enough to change the response in a few runs, small enough not to jump over the optimum.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Guideline {id: "last_best_point", name: "Return to the last best point", definition: "When the response drops, go back to the best run and fit a new factorial around it.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "curvature", name: "Curvature", definition: "A bend in the response surface; every optimum has it, and a linear model cannot describe it.", aliases: ["nonlinearity"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "curvature_check", name: "Checking for curvature", definition: "Compare the model's predicted center point, b0, with the measured center point.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "quadratic_model", name: "Quadratic model", definition: "A model with squared terms such as b_TT x_T^2, to describe curvature.", aliases: ["second-order model"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:DesignType {id: "ccd", name: "Central composite design", definition: "A factorial plus center points plus axial points; fits a quadratic model.", aliases: ["CCD"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "axial_point", name: "Axial point", definition: "A run on one factor's axis, (2^k)^0.25 coded units from the center: 1.41 for 2 factors, 1.68 for 3.", aliases: ["star point"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:DesignType {id: "box_behnken", name: "Box-Behnken design", definition: "A three-level design for quadratic models, named as another design to research.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst"});
CREATE (:DOE:Plot {id: "contour_plot", name: "Contour plot", definition: "Lines of equal predicted response, used to choose where to run next.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "optimum", name: "Optimum", definition: "The settings with the best response. The surface is flat there.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Diagnostic {id: "plateau", name: "Response levels off", definition: "Successive steps give little improvement.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Diagnostic {id: "equal_jumps", name: "Two equal steps", definition: "The response stays about the same for two steps: you have jumped over the optimum.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Diagnostic {id: "overshoot", name: "Response drops", definition: "The response falls, sometimes fast, after a step: you overshot the optimum.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Diagnostic {id: "big_interactions", name: "Interactions as large as main effects", definition: "Interaction terms similar to or larger than the main effects.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Diagnostic {id: "center_mismatch", name: "Center point far from prediction", definition: "The measured center point differs from b0 by much more than the noise.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "near_optimum", name: "Near an optimum", definition: "The region where the surface bends, so a linear model no longer points the way.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "multiple_responses", name: "Several responses", definition: "Two or more outcomes that trade off, such as production rate and energy.", aliases: ["multi-objective"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "single_combined_response", name: "Combine into one response", definition: "Rewrite the outcomes as one y, such as total cost or net profit.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "overlay_surfaces", name: "Overlay the response surfaces", definition: "Superimpose the contours of each response so the trade-offs can be seen.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Guideline {id: "categorical_in_rsm", name: "Categorical factors in RSM", definition: "Fix a categorical factor, optimize the rest, then try its other value.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Method {id: "evop", name: "Evolutionary operation", definition: "Small, repeated factorial perturbations on a full-scale process to keep it at its moving optimum.", aliases: ["EVOP"], book_label: "DOE-EVOP", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Concept {id: "process_drift", name: "Process drift", definition: "The optimum moves as heat exchangers foul, catalyst deactivates, and raw materials change.", aliases: [], book_label: "DOE-EVOP", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Phase {id: "phase_screening", name: "Phase 1: screening", definition: "Put as many factors as possible into as few runs as possible, with a saturated or Plackett-Burman design.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Phase {id: "phase_sequential", name: "Phase 2: sequential runs", definition: "Add runs to the first ones: foldover, projectivity, and fractions of higher resolution.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Phase {id: "phase_optimize", name: "Phase 3: optimization", definition: "Explore the response surface of the important factors, then add curvature terms near the optimum.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Phase {id: "phase_maintain", name: "Phase 4: maintain the optimum", definition: "Keep hunting for the moving optimum with evolutionary operation.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Guideline {id: "budget_rule", name: "Spend 25% first", definition: "Spend no more than 20% to 25% of time and budget on the first group of experiments.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Guideline {id: "after_the_experiment", name: "The best time to run an experiment", definition: "The best time to run an experiment is after the experiment: you always learn what you wish you had done.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Guideline {id: "first_run_center", name: "Run the center point first", definition: "The first run often fails while you learn the protocol; make it a center point, which the analysis does not need.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst"});
CREATE (:DOE:Concept {id: "constraint", name: "Constraint", definition: "A region where the process may not operate, for safety or physical reasons.", aliases: ["limit", "infeasible region"], book_label: "DOE-handling-constraints", book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst"});
CREATE (:DOE:Concept {id: "lost_orthogonality", name: "Lost orthogonality", definition: "Moving a run to obey a constraint makes X no longer orthogonal and shrinks the region the design spans.", aliases: [], book_label: "DOE-handling-constraints", book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst"});
CREATE (:DOE:DesignType {id: "optimal_design", name: "Optimal design", definition: "Runs chosen by a computer to optimize a criterion, for a model you specify, subject to constraints.", aliases: ["computer-generated design"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Concept {id: "candidate_set", name: "Candidate set", definition: "Every allowed combination of factor levels, from which an optimal design picks its runs.", aliases: ["candidate points"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Method {id: "exchange_algorithm", name: "Candidate exchange algorithm", definition: "Swap candidate points into and out of the design until the criterion is best.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Concept {id: "optimality_criterion", name: "Optimality criterion", definition: "The quantity an optimal design optimizes, such as the determinant of X'X.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Criterion {id: "d_optimal", name: "D-optimality", definition: "Maximize det(X'X): minimize the general variance of the parameters.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Criterion {id: "a_optimal", name: "A-optimality", definition: "Minimize trace((X'X)^-1): the average variance of the parameters.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Criterion {id: "g_optimal", name: "G-optimality", definition: "Minimize the maximum variance of the predictions.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Criterion {id: "v_optimal", name: "V-optimality", definition: "Minimize the average variance of the predictions.", aliases: ["I-optimality"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Guideline {id: "specify_model", name: "Specify the model first", definition: "An optimal design needs the model before the runs; in a factorial the model is implicit.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Method {id: "augmentation", name: "Adding runs to a design", definition: "Add the runs that most improve the criterion, for example most increase det(X'X), to fix or extend a design.", aliases: ["augmentation"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:DesignType {id: "dsd", name: "Definitive screening design", definition: "A three-level screening design, a type of optimal design, that can also estimate second-order effects.", aliases: ["DSD"], book_label: "DOE-definitive-screening-designs", book_file: "design-analysis-experiments/definitive-screening-designs.rst"});
CREATE (:DOE:DesignType {id: "mixture_design", name: "Mixture design", definition: "A design for components whose proportions add to 100%.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst"});
CREATE (:DOE:Concept {id: "mixture_constraint", name: "Proportions sum to one", definition: "Mixture components cannot change independently, because sum x_i = 1.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst"});
CREATE (:DOE:Concept {id: "simplex", name: "Simplex", definition: "The triangular region of a three-component mixture: pure components at the corners.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst"});
CREATE (:DOE:Example {id: "ex_cost_bioreactor", name: "Bioreactor by COST", definition: "Changing temperature then substrate one at a time stops at 69.5% yield, short of the optimum.", aliases: [], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst"});
CREATE (:DOE:Example {id: "ex_tea", name: "The lady tasting tea", definition: "Fisher's illustration of randomization: is her score better than chance?", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Example {id: "ex_brittleness", name: "Brittleness in TK104 and TK107", definition: "The randomization test (79.6%) and the t-test (79.3%) agree.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst"});
CREATE (:DOE:Example {id: "ex_two_factor", name: "Conversion vs T and S", definition: "A 2^2 factorial in temperature and substrate: y = 61.5 - 5 x_T - 3 x_S - 0.5 x_T x_S.", aliases: [], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Example {id: "ex_handwashing", name: "Washing hands", definition: "Hot water enhances soap, and soap enhances hot water: an interaction.", aliases: [], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst"});
CREATE (:DOE:Example {id: "ex_pollutant", name: "Pollutant from a molding plant", definition: "A 2^3 factorial in chemical, temperature and stirring; a large chemical x speed interaction.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst"});
CREATE (:DOE:Example {id: "ex_yield_pressure", name: "Yield, pressure and impurity", definition: "Pressure correlates with yield only because operators raise it when impurity causes froth.", aliases: [], book_label: "DOE-yield-pressure-impurity-correlation", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst"});
CREATE (:DOE:Example {id: "ex_7_factor_screen", name: "Seven factors in eight runs", definition: "A 2^(7-4) design with D = AB, E = AC, F = BC, G = ABC; A, C and G matter.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst"});
CREATE (:DOE:Example {id: "ex_8_factor", name: "Eight factors in 16 runs", definition: "A 2^(8-4) design of resolution IV.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst"});
CREATE (:DOE:Example {id: "ex_raw_material_blocks", name: "Two batches of raw material", definition: "A 2^3 factorial split into two blocks of 4, with the batch confounded with ABC.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst"});
CREATE (:DOE:Example {id: "ex_rsm_profit", name: "Climbing to maximum profit", definition: "Factorials, steepest ascent and a central composite design find the profit optimum near 343 K and 1.6 g/L.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst"});
CREATE (:DOE:Example {id: "ex_fruit_punch", name: "Fruit punch mixture", definition: "The cheapest blend that still tastes right, with a region of high acidity excluded.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst"});
CREATE (:DOE:Example {id: "ex_cell_culture", name: "Cell-culture bioreactor", definition: "Five factors at 10 days a run: a full factorial would take almost a year.", aliases: [], book_label: "DOE-fractional-factorials", book_file: "design-analysis-experiments/fractional-factorial-designs/index.rst"});
CREATE (:DOE:Question {id: "q_narrow_factors", name: "Which of eight factors matter?", definition: "Narrow a list of plausible factors and rank their effects.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Question {id: "q_after_screening", name: "Three factors left: what next?", definition: "How to run the rest of the experiments after screening.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Question {id: "q_old_data", name: "What do these old results show?", definition: "Interpret existing experimental data and choose where to operate.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Question {id: "q_two_goals", name: "Long shelf life with less energy?", definition: "Find settings that keep one outcome good while improving another.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Question {id: "q_unsafe_corner", name: "High temperature and pressure together are unsafe", definition: "Plan an experiment when part of the region cannot be run.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Reference {id: "ref_fisher", name: "R. A. Fisher, The Design of Experiments", definition: "The source of randomization and of factorial experimentation, from the 1930s.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Reference {id: "ref_bhh", name: "Box, Hunter and Hunter, Statistics for Experimenters", definition: "The main reference for this chapter.", aliases: ["BHH"], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Reference {id: "ref_box_hunter_1961", name: "Box and Hunter, 2^(k-p) fractional factorial designs (1961)", definition: "The papers that set out fractional factorials and resolution.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Reference {id: "ref_box_1957", name: "Box, Evolutionary operation (1957)", definition: "The paper that introduced evolutionary operation.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst"});
CREATE (:DOE:Reference {id: "ref_st_john_draper", name: "St. John and Draper, D-optimality (1975)", definition: "A review of D-optimal designs.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst"});
CREATE (:DOE:Reference {id: "ref_jones_2011", name: "Jones and Nachtsheim, definitive screening (2011)", definition: "The paper that introduced definitive screening designs.", aliases: [], book_label: "DOE-definitive-screening-designs", book_file: "design-analysis-experiments/definitive-screening-designs.rst"});
MATCH (a:DOE {id: "experiment"}), (b:DOE {id: "learning_cycle"}) CREATE (a)-[:PART_OF]->(b);
MATCH (a:DOE {id: "conjecture"}), (b:DOE {id: "learning_cycle"}) CREATE (a)-[:PART_OF]->(b);
MATCH (a:DOE {id: "experiment"}), (b:DOE {id: "cause_and_effect"}) CREATE (a)-[:SHOWS]->(b);
MATCH (a:DOE {id: "happenstance_data"}), (b:DOE {id: "experiment"}) CREATE (a)-[:COMPARED_WITH]->(b);
MATCH (a:DOE {id: "happenstance_data"}), (b:DOE {id: "cause_and_effect"}) CREATE (a)-[:CANNOT_SHOW]->(b);
