// Built from graph.yaml by build_kg.py. Load into an empty database.
CREATE CONSTRAINT term_id IF NOT EXISTS FOR (n:Term) REQUIRE n.id IS UNIQUE;
CREATE (:Term:Concept {id: "experiment", name: "Experiment", definition: "Intentionally disturbing a system by changing factors, to learn cause and effect.", aliases: [], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:274", quote: "In order to learn about a system, we have to disturb it and change it. This is to ensure cause and effect."});
CREATE (:Term:Concept {id: "run", name: "Run", definition: "One experiment in a set: eight experiments are eight runs.", aliases: ["experimental run"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:338", quote: "When we perform an experiment, we call it a run."});
CREATE (:Term:Concept {id: "response", name: "Response", definition: "The measured outcome of a run, written y. It must always be measurable in some way.", aliases: ["outcome", "response variable", "y"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:300", quote: "An important aspect about the outcome is that it is always measurable--in some way."});
CREATE (:Term:Concept {id: "qualitative_outcome", name: "Qualitative outcome", definition: "An outcome described in categories, such as pass or fail, or a colour.", aliases: [], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:302", quote: "A qualitative outcome might also be a description of what happened, for example,"});
CREATE (:Term:Concept {id: "objective", name: "Objective", definition: "An outcome together with what you want of it: maximize, minimize, or keep the same.", aliases: ["goal"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:307", quote: "which combines an outcome and the need to adjust that outcome."});
CREATE (:Term:Concept {id: "factor", name: "Factor", definition: "The thing you can change to influence the outcome.", aliases: ["variable", "input"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:298", quote: "is the thing you can change to influence the outcome."});
CREATE (:Term:Concept {id: "numeric_factor", name: "Numeric factor", definition: "A factor with ordered, measured values, such as 15 mL or 30 mL of water.", aliases: ["quantitative factor", "continuous factor"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:325", quote: "Numeric factors are quantified by measuring, such as giving 15 mL of water or 30 mL of water to the plant each day."});
CREATE (:Term:Concept {id: "categorical_factor", name: "Categorical factor", definition: "A factor with a few values that have no order, such as soil A or soil B.", aliases: ["qualitative factor"], book_label: null, book_file: "design-analysis-experiments/design-analysis-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/design-analysis-experiments.rst:327", quote: "Categorical factors usually take on a limited number of values."});
CREATE (:Term:Concept {id: "level", name: "Level", definition: "A setting of a factor in a design, such as its low (-1) or high (+1) value.", aliases: ["low level", "high level"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/index.rst:19", quote: "In this section we consider the case when these factors are at two levels."});
CREATE (:Term:Concept {id: "cause_and_effect", name: "Cause and effect", definition: "A change in a factor that produces a change in the response; shown only by intentional manipulation.", aliases: ["causality"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:26", quote: "you must disturb your system, and then observe it. This is the principle of causality, or"});
CREATE (:Term:Concept {id: "happenstance_data", name: "Happenstance data", definition: "Everyday operating data, collected without intentional changes to the system; it is confounded by other events, so it cannot be relied on to imply cause and effect.", aliases: ["operating data"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:57", quote: "That is why happenstance data cannot be relied on to imply cause and effect."});
CREATE (:Term:Concept {id: "feedback_control", name: "Feedback control", definition: "Control systems keep operation in a small zone, so the data they produce carry little information.", aliases: [], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:36", quote: "Feedback control systems keep the region of operation to a small zone."});
CREATE (:Term:Concept {id: "correlation", name: "Correlation", definition: "Two variables moving together. Some association is usually present when there is a causal link, but on its own it is not sufficient evidence of causality.", aliases: [], book_label: "DOE-yield-pressure-impurity-correlation", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:63", quote: "some observable association is usually present when there is a causal link, but the association on its own is not sufficient evidence of it."});
CREATE (:Term:Concept {id: "learning_cycle", name: "Learning cycle", definition: "Conjecture, expected consequences, experiment and data, then a new or revised conjecture.", aliases: ["iterative learning"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:12", quote: "learning from and improving a system is an iterative process. It usually follows this cycle:"});
CREATE (:Term:Concept {id: "conjecture", name: "Conjecture", definition: "A hypothesis believed true, whose consequences an experiment tests.", aliases: ["hypothesis"], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:14", quote: "Make a conjecture (hypothesis), which we believe is true."});
CREATE (:Term:Concept {id: "troubleshooting", name: "Troubleshooting", definition: "Experimenting to fix a problem, which also shows how the system works.", aliases: [], book_label: "DOE_learning_about_systems", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:19", quote: "One of the most frequent reasons we experiment is to fix a problem with our process."});
CREATE (:Term:Concept {id: "disturbance", name: "Disturbance", definition: "A variable that affects y but is not of interest: operators, ambient conditions, equipment, lab analyses, time.", aliases: [], book_label: "DOE_blocking_section", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:14", quote: "Operators, ambient conditions, physical equipment, lab analyses, and time-dependent effects (catalyst deactivation, fouling), will impact the response."});
CREATE (:Term:Concept {id: "controlled_disturbance", name: "Controlled disturbance", definition: "A disturbance held constant for all runs, so its effect cancels out.", aliases: [], book_label: "DOE_blocking_section", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:20", quote: "in which case it isn't a disturbance anymore, as it is held constant for all experiments, and its effect cancels out."});
CREATE (:Term:Concept {id: "time_effect", name: "Time-dependent effect", definition: "Slow changes such as catalyst deactivation or fouling that affect the response over time.", aliases: ["drift"], book_label: "DOE_blocking_section", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:14", quote: "and time-dependent effects (catalyst deactivation, fouling), will impact the response."});
CREATE (:Term:Concept {id: "randomization", name: "Randomization", definition: "Running experiments in random order so unknown disturbances cannot systematically affect the response.", aliases: ["random order"], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:180", quote: "experiments must be performed in random order to avoid any unmeasured, and uncontrolled, disturbances from impacting the system."});
CREATE (:Term:Method {id: "randomization_test", name: "Randomization test", definition: "Compare the observed difference with the differences from every possible reassignment of the A and B labels.", aliases: ["permutation test"], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:194", quote: "Fisher's insight was to create one long vector of these outcomes"});
CREATE (:Term:Method {id: "pairing", name: "Pairing", definition: "Running two experiments on the same subject and analysing their difference, so a shared disturbance cancels.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:16", quote: "pairing is when two experiments are run on the same subject and we analyze the differences in the two response values, rather than the actual response values."});
CREATE (:Term:Method {id: "two_group_comparison", name: "Comparing two conditions", definition: "Comparing condition A with B using a pooled variance and a confidence interval for the difference.", aliases: ["A versus B test"], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:19", quote: "We first calculate a pooled variance, then a"});
CREATE (:Term:Concept {id: "pooled_variance", name: "Pooled variance", definition: "A combined variance estimate from two groups, used in the z-value for their difference.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:40", quote: "which already assumes the spread at level A equals the spread at level B."});
CREATE (:Term:Concept {id: "indicator_variable", name: "Indicator variable", definition: "A 0/1 variable that codes condition A or B in a least squares model.", aliases: ["dummy variable"], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:141", quote: "is an indicator variable. For example,"});
CREATE (:Term:Concept {id: "confidence_interval", name: "Confidence interval", definition: "A range for an effect; the effect is statistically significant when the interval does not span zero.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:33", quote: "significant effect when this confidence interval does not span zero."});
CREATE (:Term:Concept {id: "t_distribution", name: "t-distribution", definition: "The reference distribution for a difference or a coefficient divided by its standard error.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:31", quote: "from the data (rather than known), this statistic is strictly"});
CREATE (:Term:Concept {id: "null_hypothesis", name: "Null hypothesis", definition: "The statement a test takes as true until the data give evidence against it; for A versus B, that there is no difference between them.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:196", quote: "We do this because the null hypothesis, the statement a test takes as true until the data give evidence against it, is that there is no difference between A and B."});
CREATE (:Term:Concept {id: "statistical_significance", name: "Statistical significance", definition: "An effect is statistically significant when its confidence interval does not span zero; without replicates, Lenth's margin of error gives an objective cutoff instead.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:12", quote: "There are three ways to judge whether a main effect or interaction is significant."});
CREATE (:Term:Concept {id: "practical_significance", name: "Practical significance", definition: "Whether an effect is large enough to matter, judged from the interval's width and the process variance.", aliases: [], book_label: "DOE_expts_with_single_variable", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:33", quote: "However, the width of this interval and how symmetrically it spans zero can cause us to come to a different,"});
CREATE (:Term:Method {id: "cost", name: "Changing one single variable at a time", definition: "Changing one factor at a time, in a search or a fixed design: interactions go unestimated, effects are less precise than a factorial's, and a search can stop at a suboptimal point.", aliases: ["COST", "OFAT", "one factor at a time"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst", chapter: 5, evidence: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst:25", quote: "is not an efficient way for experimentation. Note that OFAT is an alternative name for COST"});
CREATE (:Term:Concept {id: "false_optimum", name: "False optimum", definition: "A point that looks best when factors are changed one at a time, but is not the optimum.", aliases: ["suboptimal solution"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst", chapter: 5, evidence: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst:46", quote: "Changing one single variable at a time leads you into thinking you've reached the optimum, when all you've done in fact is trap yourself at a suboptimal solution."});
CREATE (:Term:Concept {id: "order_dependence", name: "Order dependence", definition: "With COST the result depends on which factor is changed first.", aliases: [], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst", chapter: 5, evidence: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst:48", quote: "This is very unsatisfactory: we cannot use methods to optimize our processes that depend on the order of experiments!"});
CREATE (:Term:Concept {id: "designed_experiment", name: "Designed experiment", definition: "A planned set of runs; with several factors it changes them simultaneously, often needing fewer runs than COST, and gives the same result whatever the run order.", aliases: ["experimental arrangement", "DOE", "design of experiments", "experimental design"], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst", chapter: 5, evidence: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst:52", quote: "Designed experiments are always run in random order -- as we will presently see -- and we will get the same result, no matter the order."});
CREATE (:Term:DesignType {id: "full_factorial", name: "Full factorial", definition: "Every combination of the factors' levels. At two levels per factor, 2^k runs for k factors.", aliases: ["complete factorial", "2^k factorial", "two-level factorial"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:25", quote: "the :math:`2` refers to the number of levels for each factor"});
CREATE (:Term:Concept {id: "coding", name: "Coding", definition: "Centering and scaling a factor; the standard form is (value - center)/(range/2), so low is -1 and high is +1.", aliases: ["coded units", "centering and scaling"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst:28", quote: "It is standard practice to represent the data from designed experiments in a centered and scaled form:"});
CREATE (:Term:Concept {id: "standard_order", name: "Standard order", definition: "Writing runs with the first factor's sign alternating fastest and the last slowest.", aliases: ["Yates order"], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:25", quote: "which alternates the sign of the first variable the fastest and the last variable the slowest."});
CREATE (:Term:Guideline {id: "operating_range", name: "Choosing the factor range", definition: "Choose low and high at the edges of normal operation, not at the extreme values a factor could take.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/index.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/index.rst:19", quote: "The general guidance is to choose the low and high values at the edges of normal operation."});
CREATE (:Term:Plot {id: "cube_plot", name: "Cube plot", definition: "The design drawn as a square or cube with the response written at each corner.", aliases: [], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:62", quote: "For simple systems you can visualize the design and results"});
CREATE (:Term:Concept {id: "main_effect", name: "Main effect", definition: "The average change in y when a factor moves from its low to its high level.", aliases: ["effect"], book_label: "DOE-two-level-factorials-main-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:79", quote: "The effects are considered, by convention, to be the difference from the high level to the low level."});
CREATE (:Term:Concept {id: "interaction", name: "Interaction", definition: "When the effect of one factor depends on the level of another. Interactions are symmetric.", aliases: ["factor dependence", "interaction effect"], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:134", quote: "In summary, interaction means the effect of one factor depends on the level of the other factor."});
CREATE (:Term:Concept {id: "two_factor_interaction", name: "Two-factor interaction", definition: "The interaction of two factors, such as T x S.", aliases: ["2fi"], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:186", quote: "What is missing is an interaction term, given by the product of temperature and substrate."});
CREATE (:Term:Concept {id: "three_factor_interaction", name: "Three-factor interaction", definition: "The interaction of three factors; seldom large in real systems.", aliases: ["3fi"], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/index.rst:19", quote: "Very very seldom do three-factor interactions occur, nor are they often of practical significance."});
CREATE (:Term:Plot {id: "interaction_plot", name: "Interaction plot", definition: "The response against one factor, a line per level of another; lines that are not parallel show interaction.", aliases: [], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:186", quote: "The lack of parallel lines is a clear indication of interaction."});
CREATE (:Term:Method {id: "least_squares_model", name: "Least squares model", definition: "y = Xb + e, fitted with b = (X'X)^-1 X'y. It works even when the design was not run exactly as planned.", aliases: ["least squares", "linear model", "regression"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst:28", quote: "whether the experimental design was executed accurately or not: the least squares model always works"});
CREATE (:Term:Concept {id: "model_matrix", name: "Model matrix X", definition: "One row per run and one column per model term, with a column of ones for the intercept.", aliases: ["table of signs", "X matrix", "design matrix"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:147", quote: "Each row is one experimental run; each column is one term in the model."});
CREATE (:Term:Property {id: "orthogonality", name: "Orthogonality", definition: "The columns of X are mutually orthogonal, so X'X is diagonal and each coefficient is estimated and interpreted separately. Quadratic columns, which correlate with the intercept, are checked for orthogonality after centring.", aliases: ["orthogonal design"], book_label: "DOE_orthogonality", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst:92", quote: "matrix has only zeros on the off-diagonals: it indicates that matrix"});
CREATE (:Term:Concept {id: "intercept", name: "Intercept", definition: "The model's constant b0; for a coded factorial, the average of the runs and the predicted center point.", aliases: ["constant term", "b0"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst:104", quote: "Notice from the least squares equations how it is just the average of the four experimental values, even though we did not actually perform an experiment at the center."});
CREATE (:Term:Concept {id: "coefficient", name: "Coefficient", definition: "A parameter of the fitted model, one per term; for a coded factor's main effect it is the change in y per coded unit, over half the factor's range.", aliases: ["parameter", "slope", "Effect over half the range"], book_label: "DOE-analysis-by-least-squares", book_file: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst:98", quote: "They are the same, as long as we are careful to interpret them as the change over"});
CREATE (:Term:Guideline {id: "hierarchy_rule", name: "Keep the parent main effects", definition: "If an interaction is significant, keep in the model every main effect that it is made of.", aliases: ["model hierarchy"], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst:16", quote: "Also, if you conclude the interaction term is significant, then you must also include all main factors that make up that interaction term in the model."});
CREATE (:Term:Guideline {id: "interpret_with_interaction", name: "Read main effects with their interactions", definition: "A main effect cannot be interpreted on its own when it takes part in a significant interaction.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst:16", quote: "We cannot interpret the main effects separately from the interaction effects"});
CREATE (:Term:Concept {id: "robustness", name: "Robustness", definition: "A small effect means y is insensitive to that factor: y is robust to changes in it.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/summary-so-far.rst:22", quote: "This is desirable in some situations. It means we can adjust that"});
CREATE (:Term:Concept {id: "degrees_of_freedom", name: "Degrees of freedom", definition: "For the residual, runs minus estimated parameters: the spare runs that estimate the noise standard deviation. Pure error and lack of fit split this count between them.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:189", quote: "If there are more experiments than parameters to be estimated, then we have extra degrees of freedom."});
CREATE (:Term:Concept {id: "replicate", name: "Replicate", definition: "A complete repeat of a run: setup, running the experiment and measuring the result.", aliases: ["repeat run", "genuine replicate", "replication"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:8", quote: "a complete replicate implies the entire experiment is repeated: system setup, running the experiment and measuring the result."});
CREATE (:Term:Concept {id: "repeat_measurement", name: "Repeat measurement", definition: "Measuring one sample twice; it estimates only measurement error and is not a true replicate.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:8", quote: "is not a true replicate. That is only an estimate of the measurement error and analytical error."});
CREATE (:Term:Concept {id: "center_point", name: "Center point", definition: "A run with every factor at coded 0. It checks overall curvature and, replicated, estimates pure error, but cannot tell which factor curves; in a factorial it keeps X orthogonal.", aliases: ["centre point", "baseline run"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:234", quote: "Note that the center point runs do not change the orthogonality of"});
CREATE (:Term:Concept {id: "standard_error", name: "Standard error", definition: "The spread of an estimate such as a coefficient: its estimated standard deviation. In a coded orthogonal design, S_E(b) = sqrt(S_E^2 / sum x^2), with S_E the estimated noise standard deviation.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:191", quote: "the standard error for coefficient :math:`b_i` is :math:`S_E(b_i) = \\sqrt{\\mathcal{V}\\left(b_i\\right)} = \\sqrt{\\dfrac{S_E^2}{\\sum{x_i^2}}}`"});
CREATE (:Term:Concept {id: "noise_standard_deviation", name: "Noise standard deviation", definition: "The run-to-run scatter of the response with every factor held fixed, sigma; its estimate S_E comes from replicate runs, residual degrees of freedom or external data.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:6", quote: "There are no degrees of freedom left to estimate the noise standard deviation, the run-to-run scatter of the response when every factor is held fixed."});
CREATE (:Term:Plot {id: "pareto_plot", name: "Pareto plot", definition: "Absolute coefficients in sorted order, intercept left out; significance judged by eye. Needs coded factors.", aliases: [], book_label: "DOE-Pareto-plot", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:26", quote: "then plot as shown the absolute value of the model coefficients in sorted order, from largest magnitude to smallest, ignoring the intercept term."});
CREATE (:Term:Method {id: "se_significance", name: "Significance from standard errors", definition: "Report each effect with its standard error; it is significant when effect +/- c_t x SE excludes zero.", aliases: [], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:236", quote: "However, it is customary to just report the standard error next to the coefficients, so that users can apply their own level of confidence."});
CREATE (:Term:Method {id: "refit", name: "Refit without small effects", definition: "Drop clearly small effects to gain degrees of freedom, then estimate the error and check the residuals.", aliases: ["model reduction"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:248", quote: "After having established which effects are significant, we can exclude the nonsignificant effects and increase the degrees of freedom."});
CREATE (:Term:Method {id: "residual_analysis", name: "Residual analysis", definition: "Residuals plotted in run order, against fitted values, and on a q-q plot.", aliases: ["residual plots"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:248", quote: "Plots of the residuals in experimental order, against fitted values, q-q plots and all the other assessment tools from earlier are used, as usual."});
CREATE (:Term:Property {id: "factorial_efficiency", name: "Factorial efficiency", definition: "A factorial halves a main effect's variance versus COST, partly by using more runs; those same runs also estimate the other effects and interactions at no additional cost.", aliases: [], book_label: "DOE-COST-vs-factorial-efficiency", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:289", quote: "whereas the COST comparison uses only two, so part of the variance reduction is simply the extra runs."});
CREATE (:Term:Concept {id: "missing_values", name: "Missing values", definition: "Responses lost from some runs. Main effects can often still be estimated; if the least squares model was saturated, drop higher-order interaction terms to get a square system.", aliases: [], book_label: null, book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst:26", quote: "if the least squares model was saturated, it becomes an underdetermined system: more unknowns than equations"});
CREATE (:Term:Concept {id: "off_target_run", name: "Off-target run", definition: "A run set to a level other than planned. Code its actual value and fit by least squares; X is then almost orthogonal.", aliases: [], book_label: null, book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst:18", quote: "will not be a diagonal matrix, but it will be almost diagonal."});
CREATE (:Term:DesignType {id: "fractional_factorial", name: "Fractional factorial", definition: "A fraction of a full factorial's runs, chosen systematically by generators rather than at random. At two levels per factor, 2^(k-p) runs for k factors.", aliases: ["2^(k-p) design"], book_label: "DOE-fractional-factorials", book_file: "design-analysis-experiments/fractional-factorial-designs/index.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst:6", quote: "In general, we can run a :math:`2^{k-p}` fractional factorial."});
CREATE (:Term:DesignType {id: "half_fraction", name: "Half fraction", definition: "Half of a full factorial: 2^(k-1) runs.", aliases: ["half replicate"], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst:24", quote: "So this is our half-factorial designed experiment in 3 factors, but it only requires 4 experiments as shown by the open points in the figure."});
CREATE (:Term:DesignType {id: "quarter_fraction", name: "Quarter fraction", definition: "A quarter of a full factorial: 2^(k-2) runs.", aliases: ["quarter replicate"], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst:6", quote: "while a :math:`2^{k-2}` design is a quarter fraction, and so on."});
CREATE (:Term:DesignType {id: "complementary_fraction", name: "Complementary half fraction", definition: "The other half of a full factorial, made by flipping the sign of the generator.", aliases: [], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:106", quote: "This complementary fraction is found by flipping the sign on the generating factor."});
CREATE (:Term:DesignType {id: "saturated_design", name: "Saturated design", definition: "A design with one run per estimated term, such as 7 factors in 8 runs; usually resolution III.", aliases: [], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst:6", quote: "is one in which the number of runs equals the number of parameters being estimated, so there are **no degrees of freedom left over**."});
CREATE (:Term:DesignType {id: "plackett_burman", name: "Plackett-Burman design", definition: "A screening design in any multiple of 4 runs from 12: 12, 16, 20, 24, ...", aliases: ["Plackett and Burman design", "PB design"], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst:181", quote: "Plackett-Burman designs are screening designs that can be run in any multiple of 4"});
CREATE (:Term:Concept {id: "confounding", name: "Confounding", definition: "Two effects cannot be separated, so their coefficient estimates their sum.", aliases: ["confusing", "Alias", "aliasing"], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst:138", quote: "the least-squares coefficient is a sum of both these effects."});
CREATE (:Term:Concept {id: "alias_structure", name: "Alias structure", definition: "The list of aliases of every effect in a design.", aliases: ["alias pattern", "confounding pattern"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:8", quote: "Calculating which main effects and two-factor interactions will be confounded with each other, called the"});
CREATE (:Term:Concept {id: "collinearity", name: "Collinearity", definition: "A column of X equal to another column, or to a linear combination of others (perfect collinearity), so X'X is singular and cannot be inverted.", aliases: [], book_label: "DOE-half-fractions", book_file: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/half-fractions.rst:63", quote: "because one or more columns are exactly identical to another column, also known as"});
CREATE (:Term:Concept {id: "generator", name: "Generator", definition: "Assigning an extra factor to an interaction column, such as D = ABC.", aliases: ["generating relation"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:14", quote: "This is called the *generating relation* for the design."});
CREATE (:Term:Concept {id: "word", name: "Word", definition: "A product of factor letters equal to I, such as ABD.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst:63", quote: "The generator terms such as **ABD** and **ACE** are called"});
CREATE (:Term:Concept {id: "defining_relation", name: "Defining relation", definition: "All the words equal to I, found from the products of the generators: 2^p words.", aliases: ["defining relationship"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst:127", quote: "factorial design is produced by :math:`p` generators and has a defining relationship of :math:`2^p` words."});
CREATE (:Term:Concept {id: "identity_column", name: "Identity column I", definition: "The column of ones. Any factor times itself is I.", aliases: ["identity"], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:16", quote: "A factor multiplied by itself is the identity, or intercept column"});
CREATE (:Term:Method {id: "alias_calculation", name: "Finding aliases", definition: "Multiply an effect by the defining relation to list what it is aliased with.", aliases: [], book_label: "DOE-generators", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:31", quote: "can be found quickly by multiplying the effect we are interested in by the defining relationship."});
CREATE (:Term:Guideline {id: "reassign_letters", name: "Reassign factors to letters", definition: "Choose which real factor gets which letter to obtain the least harmful confounding.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst:125", quote: "then just reassign the factors to the letters to achieve the \"least-worst\" confounding for your situation."});
CREATE (:Term:Property {id: "resolution", name: "Resolution", definition: "The length of the shortest word in the defining relation, written as a Roman numeral.", aliases: ["design resolution"], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:11", quote: "of a design is given by the length of the shortest word in the defining relation."});
CREATE (:Term:Property {id: "resolution_iii", name: "Resolution III", definition: "Shortest defining word has three letters: main effects are not confounded with each other but are aliased with two-factor interactions. Good for screening.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:23", quote: "Main effects are not confounded with each other."});
CREATE (:Term:Property {id: "resolution_iv", name: "Resolution IV", definition: "Main effects are clear of two-factor interactions, which are aliased with each other. Good for characterizing.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:31", quote: "Main effects are not aliased with two-factor interactions either"});
CREATE (:Term:Property {id: "resolution_v", name: "Resolution V", definition: "Shortest word in the defining relation has five letters: no main effect or two-factor interaction is aliased with another, but two-factor interactions are aliased with three-factor interactions.", aliases: [], book_label: "DOE-design-resolution", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:40", quote: "But two-factor interactions are aliased with three-factor interactions"});
CREATE (:Term:Concept {id: "trade_off_table", name: "Trade-off table", definition: "Resolution against number of factors and runs (Box, Hunter and Hunter, p 272).", aliases: [], book_label: "DOE_design_trade_off_BHH_272", book_file: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:51", quote: "You can use the following table to visualize the trade-off between design resolution, the number of factors"});
CREATE (:Term:Property {id: "projectivity", name: "Projectivity", definition: "A design of resolution R contains a full factorial in any R - 1 factors.", aliases: [], book_label: null, book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst:62", quote: "contains an embedded full factorial using a combination of any 3 factors"});
CREATE (:Term:Method {id: "foldover", name: "Foldover", definition: "Running a second fraction with signs switched, then analysing both fractions together.", aliases: [], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst:18", quote: "Now consider putting all 16 runs together and analyzing the joint results."});
CREATE (:Term:Method {id: "single_factor_foldover", name: "Single-factor foldover", definition: "Switch the signs of one factor to de-alias it and its two-factor interactions.", aliases: ["switch one sign"], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst:20", quote: "switching the sign of one factor will de-alias that factor's main effect, and all its associated two-factor interactions"});
CREATE (:Term:Method {id: "full_foldover", name: "Full foldover", definition: "Switch all signs to raise a resolution III design to resolution IV.", aliases: ["switch all signs"], book_label: "DOE-foldover-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst:34", quote: "Its shortest word now has four letters, so this is a"});
CREATE (:Term:Concept {id: "sequential_experimentation", name: "Sequential experimentation", definition: "Experiments are run in stages, each designed from what the last one revealed.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-foldover-and-projectivity.rst:10", quote: "Experiments are not a one-shot operation. They are almost always sequential, as we learn more and more about our system."});
CREATE (:Term:Concept {id: "screening", name: "Screening", definition: "Finding the few important factors among many candidates.", aliases: [], book_label: "DOE-saturated-screening-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:22", quote: "to separate out the important factors from the many potential factors."});
CREATE (:Term:Concept {id: "effect_sparsity", name: "Few large effects", definition: "Only a few of the many factors studied drive most of the variation in the response: the experimental form of the Pareto principle.", aliases: ["effect sparsity", "effect hierarchy", "sparsity of effects"], book_label: "DOE-screening-principles", book_file: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst:194", quote: "The principle of effect sparsity states that only a few of the many factors studied drive most of the variation in the response."});
CREATE (:Term:Method {id: "blocking", name: "Blocking", definition: "Running the experiment in groups so a known disturbance affects the response without misleading the results.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:18", quote: "blocking is a special way of running the experiment so that the disturbance actually does affect the response, but we construct the experiment so that this effect is not misleading."});
CREATE (:Term:Concept {id: "block", name: "Block", definition: "A group of runs made under one level of a disturbance, such as one batch of material. Runs within a block are randomized.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:54", quote: "The experiments within each block must be run randomly."});
CREATE (:Term:Concept {id: "block_generator", name: "Block generator", definition: "The interaction the block effect is confounded with, such as block = ABC.", aliases: [], book_label: "DOE-Generators-for-blocking", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:113", quote: "to confound the two blocks of experiments with the 3-factor interaction, **ABC**."});
CREATE (:Term:Guideline {id: "block_on_highest", name: "Block on the highest interaction", definition: "When splitting a 2^k factorial into two blocks, confound the block effect with the highest possible interaction. With more blocks, keep all block contrasts, including products, off main effects.", aliases: [], book_label: "DOE-Generators-for-blocking", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:115", quote: "You should always confound your block effect on the highest possible interaction term."});
CREATE (:Term:Method {id: "rsm", name: "Response surface methods", definition: "A sequence of local empirical models of the response surface, fitted to explore how the factors affect the response and to move the process towards its optimum.", aliases: ["RSM", "response surface methodology"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:18", quote: "RSM is a way to explore the effect of operating conditions (the factors) on the response variable"});
CREATE (:Term:Concept {id: "response_surface", name: "Response surface", definition: "The unknown surface of y over the factors' space.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:18", quote: "As we map out the unknown response surface of"});
CREATE (:Term:Method {id: "steepest_ascent", name: "Steepest ascent", definition: "Move all factors in proportion to their main-effect coefficients, in coded units: delta x_i = (b_i / b_A) delta x_A. Useful while main effects are large compared with interactions, curvature and noise.", aliases: ["path of steepest ascent", "Steepest descent"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:581", quote: "it is a useful direction to climb while the main effects are large compared with the two-factor interactions, the curvature and the noise"});
CREATE (:Term:Concept {id: "step_size", name: "Step size", definition: "Big enough to change the response in a few runs, small enough not to jump over the optimum.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:44", quote: "big enough to cause a change in the response in a reasonable number of experiments, but not so big as to miss an optimum."});
CREATE (:Term:Guideline {id: "last_best_point", name: "Return to the last best point", definition: "When the response drops, go back to the best run and fit a new factorial around it.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:182", quote: "So we return back to our *last best point*, because the surface has obviously changed, and we should refit our model with a new factorial in this neighbourhood"});
CREATE (:Term:Concept {id: "curvature", name: "Curvature", definition: "A bend in the response surface; every optimum has it, and a linear model cannot describe it.", aliases: ["nonlinearity"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:239", quote: "An optimum exhibits curvature, so a model that only has linear terms in it will not be suitable"});
CREATE (:Term:Method {id: "curvature_check", name: "Checking for curvature", definition: "Compare the model's predicted center point, b0, with the measured center point.", aliases: ["overall curvature check", "curvature contrast"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:591", quote: "Curvature can be assessed by comparing the predicted center point, i.e. the model's intercept"});
CREATE (:Term:Concept {id: "quadratic_model", name: "Quadratic model", definition: "Outside mixtures, a model with squared terms such as b_TT x_T^2, to describe curvature. A mixture's second-order Scheffe model has none: they fold into its cross-products.", aliases: ["second-degree equation", "general second-order model", "second-order model"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:67", quote: "the pure quadratics add nothing and must be left out."});
CREATE (:Term:DesignType {id: "ccd", name: "Central composite design", definition: "A factorial plus center points plus axial points; fits a quadratic model.", aliases: ["composite design", "CCD"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:593", quote: "If there is curvature, add axial points to expand the factorial into a central composite design."});
CREATE (:Term:Concept {id: "axial_point", name: "Axial point", definition: "Outside mixture designs, a central composite design run with one factor off-centre and the rest at 0: about 1.4 coded units out for 2 factors, 1.7 for 3 (rotatable); \u00b11 face-centred.", aliases: ["star point"], book_label: "DOE_central_composite_designs", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:253", quote: "coded units away from the center for a 2 factor system"});
CREATE (:Term:DesignType {id: "box_behnken", name: "Box-Behnken design", definition: "A three-level response surface design for the full quadratic model with no runs at the cube corners; suits infeasible corners but cannot be built sequentially from a factorial.", aliases: [], book_label: "DOE-box-behnken-designs", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:447", quote: "A BBD places no runs at the cube vertices: there is no run with every"});
CREATE (:Term:Plot {id: "contour_plot", name: "Contour plot", definition: "Lines of equal predicted response, used to choose where to run next.", aliases: ["contour diagram"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:599", quote: "Draw contour plots of this estimated response surface"});
CREATE (:Term:Concept {id: "optimum", name: "Optimum", definition: "The allowed settings with the best response. The surface is flat at an optimum inside the region, but need not be at one on a constraint.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:231", quote: "An optimum on a constraint, at the edge of that region, need not be flat"});
CREATE (:Term:Diagnostic {id: "plateau", name: "Response levels off", definition: "Successive steps give little improvement.", aliases: ["Two equal steps"], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:231", quote: "The response variable will start to plateau, since, recall that the first derivative is zero at an optimum"});
CREATE (:Term:Diagnostic {id: "overshoot", name: "Response drops", definition: "The response falls, sometimes fast, after a step: you overshot the optimum.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:235", quote: "The response variable decreases, sometimes very rapidly, because we have overshot the optimum."});
CREATE (:Term:Diagnostic {id: "big_interactions", name: "Interactions as large as main effects", definition: "Interaction terms similar to or larger than the main effects.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:237", quote: "The two-factor interaction terms become similar to, or larger than, the main effect terms."});
CREATE (:Term:Diagnostic {id: "center_mismatch", name: "Center point far from prediction", definition: "The measured center point differs from the predicted center point, b0, by an amount that is large compared with the model's effects.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:591", quote: "A large difference in the prediction, when compared to the model's effects, indicates the response surface is curved."});
CREATE (:Term:Concept {id: "near_optimum", name: "Near an optimum", definition: "The region where the surface bends, so a linear model no longer points the way.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:239", quote: "An optimum exhibits curvature, so a model that only has linear terms in it will not be suitable to use to find the direction of steepest ascent"});
CREATE (:Term:Concept {id: "multiple_responses", name: "Several responses", definition: "Two or more outcomes that trade off, such as production rate and energy.", aliases: ["multi-objective"], book_label: "DOE-multi-response-optimization", book_file: "design-analysis-experiments/multi-response-optimization.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:606", quote: "For example we can achieve a higher production rate, but it is at the expense of more energy."});
CREATE (:Term:Method {id: "single_combined_response", name: "Combine into one response", definition: "Rewrite the outcomes as one y, such as total cost or net profit.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:608", quote: "One way to balance all competing objectives is to rephrase the"});
CREATE (:Term:Method {id: "overlay_surfaces", name: "Overlay the response surfaces", definition: "Superimpose the contours of each response so the trade-offs can be seen.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:610", quote: "This is tremendously helpful when discussing and evaluating alternate operating points, because plant managers and operators can then visually see the trade-offs."});
CREATE (:Term:Guideline {id: "categorical_in_rsm", name: "Categorical factors in RSM", definition: "Fix a categorical factor, optimize the rest, then try its other value.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:618", quote: "are handled by fixing them at one or the other value, and then performing the optimization conditional on those selected values."});
CREATE (:Term:Method {id: "evop", name: "Evolutionary operation", definition: "Small, repeated factorial perturbations on a full-scale process to keep it at its moving optimum.", aliases: ["EVOP"], book_label: "DOE-EVOP", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:633", quote: "EVOP is an iterative hunt for the process optimum by making small perturbations to the system."});
CREATE (:Term:Concept {id: "process_drift", name: "Process drift", definition: "The optimum moves as heat exchangers foul, catalyst deactivates, and raw materials change.", aliases: [], book_label: "DOE-EVOP", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:631", quote: "Since the process is not constant, the optimum will gradually move away from its current operating point."});
CREATE (:Term:Phase {id: "phase_screening", name: "Phase 1: screening", definition: "Put as many factors as possible into as few runs as possible, with a saturated or Plackett-Burman design.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:26", quote: "Include as many factors into as few runs as possible. Use a saturated, resolution III design, or a Plackett and Burman design."});
CREATE (:Term:Phase {id: "phase_sequential", name: "Phase 2: sequential runs", definition: "Add runs to the first ones: foldover, projectivity, and fractions of higher resolution.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:30", quote: "The **second phase** is to add *sequential experiments* to the previous experiments."});
CREATE (:Term:Phase {id: "phase_optimize", name: "Phase 3: optimization", definition: "Explore the response surface of the important factors, then add curvature terms near the optimum.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:39", quote: "Once you reach the optimum, then second order effects and curvature must be added to assess the direction of the optimum."});
CREATE (:Term:Phase {id: "phase_maintain", name: "Phase 4: maintain the optimum", definition: "Keep hunting for the moving optimum with evolutionary operation.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:43", quote: "You should be always hunting for the process optimum."});
CREATE (:Term:Guideline {id: "budget_rule", name: "Spend 25% first", definition: "Spend no more than 20% to 25% of time and budget on the first group of experiments.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:16", quote: "do not spend more than 20% to 25% of your time and budget on your first group of experiments."});
CREATE (:Term:Guideline {id: "after_the_experiment", name: "The best time to run an experiment", definition: "The best time to run an experiment is after the experiment: you always learn what you wish you had done.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:15", quote: "The best time to run an experiment is after the experiment."});
CREATE (:Term:Guideline {id: "first_run_center", name: "Run the center point first", definition: "The first run often fails while you learn the protocol; make it a center point, which the analysis does not need.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:24", quote: "Since the center point is not required to analyze the data, it is worth using that first run to learn about your system."});
CREATE (:Term:Concept {id: "constraint", name: "Constraint", definition: "A limit on which factor settings may be run, for safety, physical or practical reasons. It may slice off part of the region, or bound a factor such as an ingredient proportion.", aliases: ["limit", "infeasible region"], book_label: "DOE-handling-constraints", book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:43", quote: "lower or upper bounds on an ingredient cut the simplex down to a smaller region inside it"});
CREATE (:Term:Concept {id: "lost_orthogonality", name: "Lost orthogonality", definition: "Moving a run to obey a constraint makes X no longer orthogonal and shrinks the region the design spans.", aliases: [], book_label: "DOE-handling-constraints", book_file: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/extended-topics-related-to-designed-experiments.rst:49", quote: "We have lost orthogonality. We have also reduced the space"});
CREATE (:Term:DesignType {id: "optimal_design", name: "Optimal design", definition: "Runs chosen by a computer to optimize a criterion, for a model you specify, subject to constraints.", aliases: ["alphabetic optimality", "computer-generated design"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:83", quote: "select the experimental runs by optimizing some criterion,"});
CREATE (:Term:Concept {id: "candidate_set", name: "Candidate set", definition: "Every allowed combination of factor levels, from which an optimal design picks its runs.", aliases: ["candidate points"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:106", quote: "The computer enumerates every combination of factor levels that satisfies the"});
CREATE (:Term:Method {id: "exchange_algorithm", name: "Candidate exchange algorithm", definition: "Point exchange: repeatedly swap a design run for a candidate point while the criterion improves; it reaches only a local optimum, so it is restarted many times.", aliases: [], book_label: "DOE-exchange-algorithms", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:302", quote: "keeping the swap whenever it improves the criterion, until no"});
CREATE (:Term:Concept {id: "optimality_criterion", name: "Optimality criterion", definition: "The quantity an optimal design optimizes, such as the determinant of X'X.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:135", quote: "A criterion is a single number computed from the design, and every criterion we use is built"});
CREATE (:Term:Criterion {id: "d_optimal", name: "D-optimality", definition: "For a fixed run count and assumed model, choose the runs that maximize det(X'X); the joint confidence region of all the coefficients is then smallest.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:203", quote: "confidence region for all the coefficients is an ellipsoid whose volume is proportional to"});
CREATE (:Term:Criterion {id: "a_optimal", name: "A-optimality", definition: "Minimize trace((X'X)^-1): the average variance of the parameters.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:212", quote: "which is exactly the sum of the individual coefficient variances (the diagonal entries of"});
CREATE (:Term:Criterion {id: "g_optimal", name: "G-optimality", definition: "Minimize the maximum variance of the predictions.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:234", quote: "G-optimality minimizes the largest prediction variance anywhere in"});
CREATE (:Term:Criterion {id: "v_optimal", name: "V-optimality", definition: "Minimize the average prediction variance over a chosen finite set of points, rather than over the whole region as I-optimality does.", aliases: ["I-optimality"], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:236", quote: "variance over the whole region. V-optimality is the closely related criterion that averages"});
CREATE (:Term:Guideline {id: "specify_model", name: "Specify the model first", definition: "An optimal design needs the model before the runs; in a factorial the model is implicit.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:116", quote: "First, the user must specify the model."});
CREATE (:Term:Method {id: "augmentation", name: "Adding runs to a design", definition: "Add the runs that most improve the criterion, for example most increase det(X'X), to fix or extend a design.", aliases: ["augmentation"], book_label: "DOE-augmenting-a-design", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:99", quote: "A D-optimal augmentation finds the extra"});
CREATE (:Term:DesignType {id: "dsd", name: "Definitive screening design", definition: "A three-level design of about 2k+1 runs, built by folding over a conference matrix plus a centre run; screens main effects, clear of all second-order effects, and detects curvature.", aliases: ["DSD"], book_label: "DOE-definitive-screening-designs", book_file: "design-analysis-experiments/definitive-screening-designs.rst", chapter: 5, evidence: "design-analysis-experiments/definitive-screening-designs.rst:8", quote: "the same needs without an optimization step: the definitive screening design."});
CREATE (:Term:DesignType {id: "mixture_design", name: "Mixture design", definition: "A design for components whose proportions add to 100%.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:14", quote: "Mixture experiments are used to optimize recipes: the factors being varied are the proportions"});
CREATE (:Term:Concept {id: "mixture_constraint", name: "Proportions sum to one", definition: "Mixture components cannot change independently, because sum x_i = 1.", aliases: ["mixture constraint", "mixture restriction"], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:34", quote: "The constraint has one immediate consequence: you cannot change a single ingredient proportion"});
CREATE (:Term:Concept {id: "simplex", name: "Simplex", definition: "In a mixture experiment, the region of allowed proportions: for three ingredients a triangle (ternary plot), with pure components at the vertices and two-ingredient blends on the edges.", aliases: ["mixture space"], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:40", quote: "Geometrically, the allowed settings form a *simplex*. For three ingredients this is a triangle,"});
CREATE (:Term:Example {id: "ex_cost_bioreactor", name: "Bioreactor by COST", definition: "Changing temperature, then substrate concentration, one at a time over eight runs raises yield from 63% to 69.7%, but stops at a suboptimal point.", aliases: [], book_label: "DOE-COST-approach", book_file: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst", chapter: 5, evidence: "design-analysis-experiments/changing-one-single-variable-at-a-time.rst:44", quote: "We're proud of ourselves because we have boosted our yield from 63% to 67%, and then from 67% to 69.7%."});
CREATE (:Term:Example {id: "ex_tea", name: "The lady tasting tea", definition: "Fisher's illustration of randomization: is her score better than chance?", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:182", quote: "If the lady has test score values better than by random chance, then there is a reasonable claim the lady is reliable."});
CREATE (:Term:Example {id: "ex_brittleness", name: "Brittleness in TK104 and TK107", definition: "Brittleness from TK104 and TK107: enumerating all 24,310 splits gives 79.6%, close to the 79.4% from the t-distribution with 15 degrees of freedom.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:200", quote: "degrees of freedom, would be 79.4%. See how close they agree?"});
CREATE (:Term:Example {id: "ex_two_factor", name: "Conversion vs T and S", definition: "A 2^2 factorial in temperature and substrate: y = 61.5 - 5 x_T - 3 x_S - 0.5 x_T x_S.", aliases: [], book_label: "DOE-two-level-factorials", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/analysis-by-least-squares-modelling.rst:104", quote: "The 61.5 term in the least squares model is the expected conversion at the baseline conditions."});
CREATE (:Term:Example {id: "ex_handwashing", name: "Washing hands", definition: "Hot water enhances soap, and soap enhances hot water: an interaction.", aliases: [], book_label: "DOE-two-level-factorials-interaction-effects", book_file: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/using-two-levels-for-two-or-more-factors.rst:132", quote: "The effect of warm water enhances the effect of soap. Conversely, the effect of soap is enhanced by using warm water."});
CREATE (:Term:Example {id: "ex_pollutant", name: "Pollutant from a molding plant", definition: "A 2^3 factorial in chemical, temperature and stirring; a large chemical x speed interaction.", aliases: [], book_label: null, book_file: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/example-design-and-analysis-of-a-three-factor-experiment.rst:132", quote: "It is expected that the chemical compound and speed have a strong effect on"});
CREATE (:Term:Example {id: "ex_yield_pressure", name: "Yield, pressure and impurity", definition: "Pressure correlates with yield only because operators raise it when impurity causes froth.", aliases: [], book_label: "DOE-yield-pressure-impurity-correlation", book_file: "design-analysis-experiments/why-learning-about-systems-is-important.rst", chapter: 5, evidence: "design-analysis-experiments/why-learning-about-systems-is-important.rst:47", quote: "However, it is the high impurity that actually causes the lower yield, not the pressure itself."});
CREATE (:Term:Example {id: "ex_7_factor_screen", name: "Seven factors in eight runs", definition: "A saturated 2^(7-4)_III design, D = AB, E = AC, F = BC, G = ABC; by Lenth's method A and C are active, G a candidate to confirm.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/saturated-designs-for-screening.rst:177", quote: "falls just below the margin, so on this evidence it is a candidate rather than a confirmed effect"});
CREATE (:Term:Example {id: "ex_8_factor", name: "Eight factors in 16 runs", definition: "A 2^(8-4) design of resolution IV.", aliases: [], book_label: "DOE-highly-fractionated-designs", book_file: "design-analysis-experiments/fractional-factorial-designs/highly-fractionated-designs.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/design-resolution.rst:14", quote: "had as the shortest word length of 4 characters, so this would be a"});
CREATE (:Term:Example {id: "ex_raw_material_blocks", name: "Two batches of raw material", definition: "A 2^3 factorial split into two blocks of 4, with the batch confounded with ABC.", aliases: [], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:50", quote: "the question is how to arrange the 2 sets of 4 runs so that the known, but unmeasurable disturbance from the impurity has the least effect on our results"});
CREATE (:Term:Example {id: "ex_rsm_profit", name: "Climbing to maximum profit", definition: "Factorials, steepest ascent and a central composite design find the profit optimum near 343 K and 1.6 g/L.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:285", quote: "As the solid contour lines in the illustration show, we should run our next experiments roughly at"});
CREATE (:Term:Example {id: "ex_fruit_punch", name: "Fruit punch mixture", definition: "The cheapest blend that still tastes right, with a region of high acidity excluded.", aliases: [], book_label: "DOE-mixture-designs", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:164", quote: "finds a lowest-cost fruit-punch recipe that still meets a taste target, with the shaded region"});
CREATE (:Term:Example {id: "ex_cell_culture", name: "Cell-culture bioreactor", definition: "Five factors at 10 days a run: a full factorial would take almost a year.", aliases: [], book_label: "DOE-fractional-factorials", book_file: "design-analysis-experiments/fractional-factorial-designs/index.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/index.rst:13", quote: "It would take almost a year to collect the data at all the combinations of"});
CREATE (:Term:Question {id: "q_narrow_factors", name: "Which of eight factors matter?", definition: "Narrow a list of plausible factors and rank their effects.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:12", quote: "How do we narrow down the list to a more manageable size and rank their effect on melt index?"});
CREATE (:Term:Question {id: "q_after_screening", name: "Three factors left: what next?", definition: "How to run the rest of the experiments after screening.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:13", quote: "Our initial screening experiments reduced the list down to three factors of interest. Now, how do we perform the rest of the experiments?"});
CREATE (:Term:Question {id: "q_old_data", name: "What do these old results show?", definition: "Interpret existing experimental data and choose where to operate.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:14", quote: "What interesting results do you see in this data, and where should we operate the system"});
CREATE (:Term:Question {id: "q_two_goals", name: "Long shelf life with less energy?", definition: "Find settings that keep one outcome good while improving another.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:15", quote: "How can we determine other settings (factors) that give long shelf life but reduce the energy consumed?"});
CREATE (:Term:Question {id: "q_unsafe_corner", name: "High temperature and pressure together are unsafe", definition: "Plan an experiment when part of the region cannot be run.", aliases: [], book_label: null, book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:16", quote: "operating at both high temperature and pressure is unsafe. How do we plan such an experiment?"});
CREATE (:Term:Reference {id: "ref_fisher", name: "R. A. Fisher, The Design of Experiments", definition: "Fisher's 1935 book; its Chapter 2 describes randomization through the lady tasting tea, and his work showed that changing one factor at a time is inefficient.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:182", quote: "The concept of randomization was elegantly described in an example by Fisher in Chapter 2 of his book,"});
CREATE (:Term:Reference {id: "ref_bhh", name: "Box, Hunter and Hunter, Statistics for Experimenters", definition: "The main reference for this chapter.", aliases: ["BHH"], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:35", quote: "Chapters 5 and 6 with topics from Chapters 11, 12, 13 and 15 are the most heavily used in this chapter."});
CREATE (:Term:Reference {id: "ref_box_hunter_1961", name: "Box and Hunter, 2^(k-p) fractional factorial designs (1961)", definition: "Box and Hunter's two-part 1961 Technometrics paper on 2^(k-p) fractional factorial designs, listed in the chapter's references.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst:36", quote: "Fractional Factorial Designs - Part I"});
CREATE (:Term:Reference {id: "ref_box_1957", name: "Box, Evolutionary operation (1957)", definition: "George Box, Evolutionary Operation: A Method for Increasing Industrial Productivity, Applied Statistics, 1957; a reading the chapter gives on evolutionary operation.", aliases: [], book_label: "DOE_references", book_file: "design-analysis-experiments/examples-of-how-designed-experiments-are-used.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:637", quote: "Some examples of the success of EVOP and a review paper are in these readings:"});
CREATE (:Term:Reference {id: "ref_st_john_draper", name: "St. John and Draper, D-optimality (1975)", definition: "A review of D-optimal designs.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:128", quote: "D-Optimality for Regression Designs: A Review"});
CREATE (:Term:Reference {id: "ref_jones_2011", name: "Jones and Nachtsheim, definitive screening (2011)", definition: "The paper that introduced definitive screening designs.", aliases: [], book_label: "DOE-definitive-screening-designs", book_file: "design-analysis-experiments/definitive-screening-designs.rst", chapter: 5, evidence: "design-analysis-experiments/definitive-screening-designs.rst:23", quote: "introduced by Jones and Nachtsheim in 2011, collapses the two phases into one."});
CREATE (:Term:DesignType {id: "omars_design", name: "OMARS design", definition: "Orthogonal minimally aliased response surface design: main effects orthogonal to one another and to every second-order effect; a catalogue filling the range between a DSD and a central composite design.", aliases: [], book_label: "DOE-omars-designs", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:12", quote: "The defining property generalises the one that makes the DSD work: the main effects are orthogonal"});
CREATE (:Term:Concept {id: "conference_matrix", name: "Conference matrix", definition: "A square matrix with zeros on the diagonal and plus or minus 1 elsewhere, with orthogonal columns; folded over with a centre run, it gives a definitive screening design.", aliases: [], book_label: "DOE-definitive-screening-designs", book_file: "design-analysis-experiments/definitive-screening-designs.rst", chapter: 5, evidence: "design-analysis-experiments/definitive-screening-designs.rst:30", quote: "of a conference matrix with a centre run added, a route to the DSD"});
CREATE (:Term:Concept {id: "mirror_image_pair", name: "Mirror-image pair", definition: "A run and its sign-flipped copy in a foldover. The pair has identical values in every second-order column, so it separates main effects but adds no distinct second-order row.", aliases: [], book_label: "DOE-omars-estimability-frontier", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:158", quote: "Runs 3 and 4 flip sign in the main-effect columns, which is what estimates the main effects, but"});
CREATE (:Term:Concept {id: "estimability_frontier", name: "Estimability frontier", definition: "The book's name for the smallest foldover that estimates every coefficient of the full second-order model jointly: N = k^2+k+1 runs, k(k-1)/2 above the parameter count.", aliases: [], book_label: "DOE-omars-estimability-frontier", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:256", quote: "The frontier is a property of the foldover construction, not of OMARS designs as such."});
CREATE (:Term:Concept {id: "omars_trade_off_table", name: "OMARS trade-off table", definition: "For each run count and number of factors, the largest model an OMARS foldover can estimate (Full, Quad or Satd) and the error degrees of freedom left to test it.", aliases: [], book_label: "DOE-omars-reading-the-table", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:374", quote: "The OMARS trade-off table as a capability staircase. Each cell gives the largest model the"});
CREATE (:Term:Concept {id: "information_matrix", name: "Information matrix", definition: "M = X'X, from the model matrix; sigma squared times its inverse is the variance-covariance matrix of the coefficients, and every optimality criterion is a summary of M.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:168", quote: "It earns its name from the least squares result for the covariance of the estimated coefficients"});
CREATE (:Term:Criterion {id: "e_optimality", name: "E-optimality", definition: "Maximize the smallest eigenvalue of X'X, strengthening the worst-estimated combination of coefficients; a minimax criterion, rarely the primary one in practice.", aliases: [], book_label: "DOE-optimal-designs", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:226", quote: "confidence ellipsoid stretches furthest. E-optimality is a minimax criterion: it forces"});
CREATE (:Term:Method {id: "coordinate_exchange_algorithm", name: "Coordinate-exchange algorithm", definition: "An optimal-design search with no candidate set: it sets each coordinate of each run in turn to the value that most improves the criterion, cycling until nothing improves.", aliases: [], book_label: "DOE-exchange-algorithms", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:306", quote: "altogether. It walks through each coordinate of each run in turn and sets it to the value that"});
CREATE (:Term:Concept {id: "effects_coding", name: "Effects coding", definition: "Coding an L-level categorical factor so its level effects sum to zero, each the departure from the average; two-level -1/+1 coding is the case L = 2.", aliases: [], book_label: "DOE-categorical-factors", book_file: "design-analysis-experiments/optimal-designs.rst", chapter: 5, evidence: "design-analysis-experiments/optimal-designs.rst:522", quote: "a two-level factor is exactly effects coding for the case"});
CREATE (:Term:Property {id: "prediction_variance", name: "Prediction variance", definition: "The variance of the fitted model's prediction at a point: sigma squared times x' M^-1 x. It depends on where you predict, on the design's layout, and on the noise.", aliases: [], book_label: "DOE-judging-and-comparing-designs", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:61", quote: "Read this as a product of three things. The variance of a prediction at a new point depends on"});
CREATE (:Term:Criterion {id: "scaled_prediction_variance", name: "Scaled prediction variance", definition: "Prediction variance times the run count, divided by sigma squared (SPV): it depends only on the design's geometry, so replicating a design does not make it look better.", aliases: ["variance function"], book_label: "DOE-judging-and-comparing-designs", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:133", quote: "The SPV depends only on the geometry of the design. The G-optimal value is its maximum"});
CREATE (:Term:Plot {id: "fraction_of_design_space_plot", name: "Fraction-of-design-space plot", definition: "SPV values at many points in the region, sorted and plotted against the fraction of the region they cover; a low, flat curve means precise, uniform prediction (FDS plot).", aliases: [], book_label: "DOE-fds-plot", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:419", quote: "therefore just the running fraction (percentiles), and the curve is the empirical cumulative"});
CREATE (:Term:Guideline {id: "judge_separability_and_precision_separately", name: "Judge separability and precision separately", definition: "A good design must tell effects apart (separability) and estimate them precisely (precision); a design can be good on one and poor on the other, so look at both.", aliases: [], book_label: "DOE-judging-and-comparing-designs", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:23", quote: "A good design has to do two separate jobs well, and it helps to keep them apart in"});
CREATE (:Term:Criterion {id: "maximum_absolute_correlation_between_model_terms", name: "Maximum absolute correlation between model terms", definition: "The largest absolute correlation between any two second-order terms after centring: the tightest confounding in the design. Zero means separable; one means identical columns.", aliases: [], book_label: "DOE-judging-and-comparing-designs", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:555", quote: "entanglement lives) is the single tightest confounding anywhere in the design (the worst case you"});
CREATE (:Term:Diagnostic {id: "variance_inflation_factor", name: "Variance inflation factor", definition: "VIF_j = 1/(1 - R_j^2): the factor by which correlation with the other model terms inflates a coefficient's variance; 1 is orthogonal, and past 5 or 10 is a flag.", aliases: [], book_label: "DOE-variance-inflation-factors", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:600", quote: "raises a flag past 5, and a serious one past 10."});
CREATE (:Term:Concept {id: "alias_matrix", name: "Alias matrix", definition: "A = (X1'X1)^-1 X1'X2: how much each term left out of the model biases each fitted coefficient. Its main-effect rows are exactly zero for DSD and OMARS designs.", aliases: ["bias matrix"], book_label: "DOE-alias-bias", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:645", quote: "interaction shifts one fitted coefficient: an entry of zero leaves that coefficient"});
CREATE (:Term:Criterion {id: "statistical_power", name: "Statistical power", definition: "The probability that the test on a coefficient is significant when the effect really has a stated size, at a stated significance level; it needs residual degrees of freedom.", aliases: [], book_label: "DOE-statistical-power", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:680", quote: "experimenter actually cares about: if an effect is really there, how likely are we to detect it? We"});
CREATE (:Term:Concept {id: "effect_size", name: "Effect size", definition: "The size of a coefficient worth detecting, in units of the noise standard deviation; power is always quoted for a stated effect size and significance level.", aliases: [], book_label: "DOE-statistical-power", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:731", quote: "It needs an effect size and a significance level, gives"});
CREATE (:Term:Criterion {id: "d_efficiency", name: "D-efficiency", definition: "Absolute D-efficiency: det(X'X)^(1/p) divided by the run count, as a percentage of a hypothetical orthogonal design; it favours smaller designs. Relative D-efficiency takes the D-optimal design as 100%.", aliases: [], book_label: "DOE-omnibus-comparison", book_file: "design-analysis-experiments/comparing-design-families.rst", chapter: 5, evidence: "design-analysis-experiments/comparing-design-families.rst:251", quote: "takes the D-optimal design as 100%, so it is worth checking which one a given package reports."});
CREATE (:Term:Guideline {id: "d_for_estimation_i_for_prediction", name: "D for estimation, I for prediction", definition: "Choose D-optimality when the goal is to estimate the coefficients and I-optimality when the goal is prediction over the region; the two often disagree.", aliases: [], book_label: "DOE-omnibus-comparison", book_file: "design-analysis-experiments/comparing-design-families.rst", chapter: 5, evidence: "design-analysis-experiments/comparing-design-families.rst:517", quote: "they frequently disagree, so choose by what you will actually do with the model. Second,"});
CREATE (:Term:Guideline {id: "compare_d_efficiency_only_at_equal_run_counts", name: "Compare D-efficiency only at equal run counts", definition: "Across run counts, D-efficiency and scaled prediction variance favour the smaller design; compare designs of different size on unscaled prediction variance, coefficient variance, power and error df.", aliases: [], book_label: "DOE-omnibus-comparison", book_file: "design-analysis-experiments/comparing-design-families.rst", chapter: 5, evidence: "design-analysis-experiments/comparing-design-families.rst:519", quote: "different run counts it favours the smaller design, so judge larger-versus-smaller on"});
CREATE (:Term:DesignType {id: "face_centred_central_composite_design", name: "Face-centred central composite design", definition: "A central composite design with its axial runs at plus or minus 1, so every run stays inside the factor ranges and each factor takes three levels.", aliases: [], book_label: "DOE-screen-then-optimise-study", book_file: "design-analysis-experiments/screen-then-optimise-study.rst", chapter: 5, evidence: "design-analysis-experiments/screen-then-optimise-study.rst:209", quote: "A face-centred central composite design (CCD) keeps every run inside the factor ranges,"});
CREATE (:Term:Property {id: "rotatability", name: "Rotatability", definition: "A design property: the prediction variance is the same at every point a fixed distance from the centre. Box-Behnken designs are rotatable or nearly rotatable.", aliases: ["rotatable design"], book_label: "DOE-box-behnken-designs", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:463", quote: "giving roughly uniform prediction variance at a"});
CREATE (:Term:Method {id: "design_based_staged_analysis", name: "Design-based staged analysis", definition: "Analysis for DSD and OMARS data: check estimability, estimate and test main effects, pool inactive ones into error, F-test for any second-order effect, then select second-order terms.", aliases: [], book_label: "DOE-analysing-economical-designs", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:788", quote: "clean; pool the inactive ones into the error estimate; then test for, and select among, the"});
CREATE (:Term:Concept {id: "effect_heredity", name: "Effect heredity", definition: "Strong heredity admits an interaction only if both parent main effects are active; weak heredity needs one. It can drop terms that locate an optimum near the centre.", aliases: [], book_label: "DOE-analysing-economical-designs", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:851", quote: "range its linear effect is small, so strong heredity can drop the terms that locate the optimum, as"});
CREATE (:Term:Concept {id: "fake_factor", name: "Fake factor", definition: "A column of a larger definitive screening design left unassigned to any factor; orthogonal to every second-order column, it picks up only noise and gives error degrees of freedom.", aliases: [], book_label: "DOE-screen-then-optimise-study", book_file: "design-analysis-experiments/screen-then-optimise-study.rst", chapter: 5, evidence: "design-analysis-experiments/screen-then-optimise-study.rst:154", quote: "present the fake factors pick up only noise. They give the analysis 2 degrees of freedom for error"});
CREATE (:Term:Guideline {id: "keep_mirror_pairs_in_one_block", name: "Keep mirror pairs in one block", definition: "To block a foldover, put each run and its mirror image in the same block; every main effect then sums to zero within each block, orthogonal to the block effect.", aliases: [], book_label: "DOE-omars-worked-study", book_file: "design-analysis-experiments/omars-worked-study.rst", chapter: 5, evidence: "design-analysis-experiments/omars-worked-study.rst:176", quote: "block, and every main effect sums to zero within each block, whichever way the pairs are divided."});
CREATE (:Term:Guideline {id: "judge_estimability_from_the_rank_of_the_model_matrix", name: "Judge estimability from the rank of the model matrix", definition: "A model can be fitted only if its model matrix has full rank; more runs than parameters is not enough, as a foldover near the parameter count shows.", aliases: [], book_label: "DOE-omars-estimability-frontier", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:253", quote: "model. Judge estimability from the rank of the model matrix, not from the"});
CREATE (:Term:Criterion {id: "minimum_aberration", name: "Minimum aberration", definition: "Among two-level fractions of the same resolution, prefer the one with the fewest shortest words in its defining relation (four-letter words at resolution IV).", aliases: [], book_label: "DOE-omars-what-a-cell-reports", book_file: "design-analysis-experiments/omars-designs.rst", chapter: 5, evidence: "design-analysis-experiments/omars-designs.rst:512", quote: "factors resolution alone does not decide: 95 designs reach resolution IV, and the table prints one"});
CREATE (:Term:Method {id: "lenth_method", name: "Lenth's method", definition: "Judges effects of an unreplicated design against a pseudo standard error from the small effects: beyond the margin of error is significant; the simultaneous margin allows for testing all.", aliases: [], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:94", quote: "When the design is unreplicated, so there are no degrees of freedom for a standard error, we can still place an objective cutoff"});
CREATE (:Term:Concept {id: "pseudo_standard_error", name: "Pseudo standard error", definition: "A robust estimate of an effect's standard error: 1.5 times the median absolute effect, taken over the effects small enough to be plausibly noise (PSE).", aliases: [], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:105", quote: "(PSE) is a robust estimate of the standard error of an effect."});
CREATE (:Term:Plot {id: "half_normal_plot", name: "Half-normal plot", definition: "Absolute effects plotted against half-normal quantiles: noise effects fall on a straight line through the origin, and the real effects break away to the upper right.", aliases: [], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:131", quote: "Noise effects fall along a straight line through the origin; the real effects break away to the upper right."});
CREATE (:Term:Concept {id: "pure_error", name: "Pure error", definition: "The run-to-run variability estimated from replicated runs at identical settings, without reference to any model.", aliases: [], book_label: "DOE-lack-of-fit", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:309", quote: "two or more runs at exactly the same factor-level combination, differ only by noise, so the spread"});
CREATE (:Term:Diagnostic {id: "lack_of_fit_test", name: "Lack-of-fit test", definition: "Splits the residual sum of squares into pure error and lack of fit; a large F ratio between them is evidence of a missing term. Needs replicated runs.", aliases: [], book_label: "DOE-lack-of-fit", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:308", quote: "The idea is to split the model's residual sum of squares into two parts. Replicated runs, meaning"});
CREATE (:Term:Concept {id: "sweet_spot", name: "Sweet spot", definition: "The region of factor space where every response meets its specification at once. It does not rank the settings inside it, and it can be empty.", aliases: [], book_label: "DOE-sweet-spot", book_file: "design-analysis-experiments/multi-response-optimization.rst", chapter: 5, evidence: "design-analysis-experiments/multi-response-optimization.rst:479", quote: "The sweet spot is the set of settings meeting every specification at once. It ranks"});
CREATE (:Term:Method {id: "individual_desirability", name: "Individual desirability", definition: "A score from 0 to 1 for one response: 0 at the unacceptable limit, 1 at the goal, with a ramp between them whose shape the weight sets.", aliases: ["desirability function"], book_label: "DOE-desirability", book_file: "design-analysis-experiments/multi-response-optimization.rst", chapter: 5, evidence: "design-analysis-experiments/multi-response-optimization.rst:482", quote: "Individual desirability grades one response from 0 to 1 between a pair of limits, with a"});
CREATE (:Term:Criterion {id: "overall_desirability", name: "Overall desirability", definition: "The geometric mean of the individual desirabilities, weighted by importances; with equal importances it is Derringer and Suich's unweighted mean. One failed specification makes it zero; maximizing it gives one recommended setting.", aliases: ["Desirability"], book_label: "DOE-desirability", book_file: "design-analysis-experiments/multi-response-optimization.rst", chapter: 5, evidence: "design-analysis-experiments/multi-response-optimization.rst:307", quote: "the unweighted geometric mean that Derringer and Suich proposed"});
CREATE (:Term:Guideline {id: "confirm_the_prediction", name: "Confirm the prediction", definition: "A recommended setting, often the predicted optimum, is a prediction: report the prediction interval for each response there, and confirm it with runs before treating it as established.", aliases: ["confirm the predicted optimum", "confirmatory run", "Confirmation run"], book_label: "DOE-uncertainty-at-the-optimum", book_file: "design-analysis-experiments/multi-response-optimization.rst", chapter: 5, evidence: "design-analysis-experiments/multi-response-optimization.rst:490", quote: "The recommended setting is a prediction. Report the prediction interval for each response"});
CREATE (:Term:Concept {id: "scheffe_model", name: "Scheffe model", definition: "The standard mixture model: linear blending and cross-product terms, with no intercept and no pure quadratics. In this form, a positive cross-product coefficient means synergistic blending.", aliases: ["second-order Scheffe model", "canonical polynomial"], book_label: "DOE-mixture-experiments", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:100", quote: "These readings hold in the Scheffe form"});
CREATE (:Term:Concept {id: "pseudocomponent", name: "Pseudocomponent", definition: "With lower bounds L_i, the rescaled proportion (a_i - L_i)/(1 - sum of L_j), which maps the constrained mixture region back onto a full simplex, so the same designs apply.", aliases: ["pseudocoordinate", "Pseudocomponents"], book_label: "DOE-mixture-experiments", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:145", quote: "the original. The same kind of design is then optimal for the constrained region as for the full"});
CREATE (:Term:DesignType {id: "mixture_process_variable_experiment", name: "Mixture-process variable experiment", definition: "A study varying ingredient proportions and ordinary process variables together; its model crosses a Scheffe model with a response-surface model, with no intercept or process-variable main effects.", aliases: [], book_label: "DOE-mixture-experiments", book_file: "design-analysis-experiments/mixture-experiments.rst", chapter: 5, evidence: "design-analysis-experiments/mixture-experiments.rst:174", quote: "the combined model has no intercept and no process-variable main effects."});
CREATE (:Term:Example {id: "screen_then_optimise_reactor_study", name: "Screen-then-optimise reactor study", definition: "A simulated six-factor reactor: a 17-run DSD screens, a 16-run optimal design in the three active factors respects a heat limit, then three confirmation runs.", aliases: [], book_label: "DOE-screen-then-optimise-study", book_file: "design-analysis-experiments/screen-then-optimise-study.rst", chapter: 5, evidence: "design-analysis-experiments/screen-then-optimise-study.rst:12", quote: "This section runs both stages on a simulated reactor whose true behaviour is known, so the"});
CREATE (:Term:Criterion {id: "margin_of_error", name: "Margin of error", definition: "Lenth's individual 95% cutoff, t(0.975, m/3) times the pseudo standard error; an effect whose magnitude exceeds it is significant on its own.", aliases: [], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:105", quote: "(ME) is the individual 95% cutoff: an effect whose magnitude exceeds the ME is significant on its own."});
CREATE (:Term:Criterion {id: "simultaneous_margin_of_error", name: "Simultaneous margin of error", definition: "Lenth's stricter cutoff for testing all m effects at once, set so that all noise effects together stay below it with probability 0.95.", aliases: [], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:105", quote: "It is the stricter cutoff to use when scanning many effects at once."});
CREATE (:Term:Guideline {id: "allocating_runs_between_two_levels", name: "Allocating runs between two levels", definition: "For a fixed budget, split runs in proportion to sigma divided by the square root of cost; the even split is best only for equal variances and costs.", aliases: [], book_label: "DOE-two-level-allocation", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:128", quote: "The general principle is to place more runs where the variance is larger and where the runs are cheaper."});
CREATE (:Term:Concept {id: "reference_distribution", name: "Reference distribution", definition: "The histogram of the difference in averages over every possible split of the results into groups A and B, against which the observed difference is judged.", aliases: [], book_label: "DOE-randomization", book_file: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst", chapter: 5, evidence: "design-analysis-experiments/experiments-with-a-single-variable-at-two-levels.rst:202", quote: "You can build the reference distribution yourself; enumerating all 24,310 splits takes under a second:"});
CREATE (:Term:Method {id: "blocking_into_more_than_two_blocks", name: "Blocking into more than two blocks", definition: "Index g blocks with new two-level block variables generated from interactions, chosen so that no block contrast, including their products, is confounded with a main effect.", aliases: ["Blocking into more than two groups"], book_label: "DOE-Generators-for-blocking", book_file: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst", chapter: 5, evidence: "design-analysis-experiments/fractional-factorial-designs/generators-defining-relationships-blocking.rst:153", quote: "The goal is to keep those three block contrasts away from the effects we care about, and especially away from the main effects."});
CREATE (:Term:Guideline {id: "randomization_replication_and_blocking", name: "Randomization, replication and blocking", definition: "Three principles that underpin the design of any experiment: randomize against unmeasured disturbances, replicate to estimate the noise, block to absorb known nuisance variation.", aliases: [], book_label: "DOE-general-approach", book_file: "design-analysis-experiments/general-approach-for-experimentation.rst", chapter: 5, evidence: "design-analysis-experiments/general-approach-for-experimentation.rst:18", quote: "Three principles underpin the design of any experiment: randomization, replication, and blocking."});
CREATE (:Term:DesignType {id: "split_plot_design", name: "Split-plot design", definition: "Hard-to-change factors are held over a block of consecutive runs, a whole plot, while easy-to-change factors are reset within it, because full randomization is impractical.", aliases: [], book_label: "APPS_mixed_level_profile_case_study", book_file: "product-development-product-improvement/mixed-level-profile-case-study.rst", chapter: 7, evidence: "product-development-product-improvement/mixed-level-profile-case-study.rst:62", quote: "split-plot: the two hard-to-change factors are held over a block of runs (a whole plot) while the"});
CREATE (:Term:Concept {id: "coding_schemes_for_a_categorical_factor", name: "Coding schemes for a categorical factor", definition: "Ways to remove the redundant indicator column: reference coding drops one level, sum coding makes level effects sum to zero, cell-means coding drops the intercept. Coefficients change meaning.", aliases: [], book_label: "profile-coding-intro", book_file: "product-development-product-improvement/mixed-level-profile-case-study.rst", chapter: 7, evidence: "product-development-product-improvement/mixed-level-profile-case-study.rst:412", quote: "the choice fixes what each compound coefficient means:"});
CREATE (:Term:Method {id: "joint_f_test_of_a_categorical_interaction", name: "Joint F-test of a categorical interaction", definition: "A categorical-by-continuous interaction carries one coefficient fewer than the number of levels; one F-test checks them all at once, showing the slopes differ without naming which level.", aliases: [], book_label: "APPS_mixed_level_profile_case_study", book_file: "product-development-product-improvement/mixed-level-profile-case-study.rst", chapter: 7, evidence: "product-development-product-improvement/mixed-level-profile-case-study.rst:552", quote: "compounds. The F-test is a single joint test of all five at once: it weighs the drop in the"});
CREATE (:Term:Concept {id: "region_of_interest", name: "Region of interest", definition: "A range for each factor around the current conditions, over which the runs are placed and the local model is meant to hold.", aliases: [], book_label: "DOE-RSM", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:23", quote: "for each factor around the current conditions, over which the local model is meant to hold."});
CREATE (:Term:Method {id: "analysis_of_variance", name: "Analysis of variance", definition: "Splits the total sum of squares into parts (groups of terms, blocks, lack of fit, pure error), each with its degrees of freedom, and compares their mean squares by F ratios.", aliases: ["ANOVA", "ANOVA table"], book_label: "DOE-lack-of-fit", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:353", quote: "splits the residual row into lack of fit and pure error when some runs are replicated"});
CREATE (:Term:Method {id: "extra_sum_of_squares_test", name: "Extra sum of squares test", definition: "An F-test of a group of terms: the drop in residual sum of squares when they are added, per added term, divided by the larger model's residual mean square.", aliases: ["partial F-test"], book_label: "DOE-lack-of-fit", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:363", quote: "group of terms at once rather than one coefficient at a time."});
CREATE (:Term:Method {id: "response_transformation", name: "Response transformation", definition: "Fitting the model to a function of the response, such as log y, so the noise variance is nearly constant and effects that multiply become additive, needing fewer interaction terms.", aliases: ["transforming the response", "log transformation"], book_label: "DOE-replicate_points", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:253", quote: "fitting the model to a function of the response, such as :math:`\\log y`, instead of :math:`y`."});
CREATE (:Term:Plot {id: "normal_probability_plot_of_effects", name: "Normal probability plot of effects", definition: "Signed effects plotted against normal quantiles: noise effects lie on a line, and real effects leave it at the upper right if positive, lower left if negative.", aliases: ["normal plot of effects"], book_label: "DOE-lenth-method", book_file: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst", chapter: 5, evidence: "design-analysis-experiments/full-factorial-designs/assessing-significance-of-main-effects-and-interactions.rst:133", quote: "which some software draws instead, plots the signed effects against normal quantiles."});
CREATE (:Term:Concept {id: "bias_error", name: "Bias error", definition: "The systematic miss of a fitted model's expected prediction, from terms left out; mean squared error is variance plus its square, and replicating the design does not reduce it.", aliases: ["model bias"], book_label: "DOE-alias-bias", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:662", quote: "misses the true response by the :index:`bias error <pair: bias error; experiments>`"});
CREATE (:Term:Concept {id: "stationary_point", name: "Stationary point", definition: "The settings where every first derivative of a fitted quadratic model is zero. It can be a maximum, a minimum or a saddle point, so it is not necessarily an optimum.", aliases: [], book_label: "DOE-RSM-canonical-analysis", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:391", quote: "A stationary point can be a maximum, a minimum, or a *saddle point*"});
CREATE (:Term:Method {id: "canonical_analysis", name: "Canonical analysis", definition: "Rewriting a fitted quadratic model about its stationary point on rotated axes with no cross-products, so the eigenvalues' signs show a maximum, minimum or saddle, and near-zero ones show flat directions.", aliases: [], book_label: "DOE-RSM-canonical-analysis", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:399", quote: "It moves the origin to the stationary point and turns"});
CREATE (:Term:Method {id: "ridge_analysis", name: "Ridge analysis", definition: "Tracing the settings of highest (or lowest) predicted response on spheres of growing radius about the design centre. For a first-order model this is the path of steepest ascent.", aliases: [], book_label: "DOE-RSM-canonical-analysis", book_file: "design-analysis-experiments/response-surface-methods.rst", chapter: 5, evidence: "design-analysis-experiments/response-surface-methods.rst:427", quote: "Ridge analysis finds the settings of highest (or lowest)"});
CREATE (:Term:Concept {id: "additive_block_effect", name: "Additive block effect", definition: "A block shifts every response in it by the same amount, whatever the factor settings; otherwise a block-by-factor interaction is confounded with another effect, such as a two-factor interaction.", aliases: ["block additivity", "no block-by-factor interaction"], book_label: "DOE-Blocking-and-confounding", book_file: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst", chapter: 5, evidence: "design-analysis-experiments/blocking-and-confounding-for-disturbances.rst:103", quote: "every response in its block by the same amount"});
CREATE (:Term:Property {id: "scale_sensitivity_of_optimality_criteria", name: "Scale sensitivity of optimality criteria", definition: "Spreading runs wider raises D, lowers A and cannot lower E, so designs compare only on one region and coding; a common rescaling keeps D ratios but can reorder A and E.", aliases: ["scale dependence of the alphabetic criteria"], book_label: "DOE-judging-and-comparing-designs", book_file: "design-analysis-experiments/judging-and-comparing-designs.rst", chapter: 5, evidence: "design-analysis-experiments/judging-and-comparing-designs.rst:271", quote: "The raw criteria scale with the spread of the runs as well as with their number."});
